# Dependencias
node_modules
# Excepción: los módulos vendorizados del agente de impresión viajan DENTRO del
# tarball (print-agent/vendor/LEEME.md) y tienen que estar en el repo para que
# el artefacto sea reproducible desde un checkout limpio (#96).
!print-agent/vendor/node_modules/
!print-agent/vendor/node_modules/**

# Build
dist
dist-ssr
*.tsbuildinfo

# Variables de entorno (claves) — NO subir
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Sistema / editor
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea

# Playwright (Phase 1 QA)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Vista previa local de los correos de prueba (scripts/emails-prueba.mjs)
/.emails-prueba/

# Estado de sesión del arnés E2E (cookies HttpOnly sembradas)
/e2e/.auth/

# Registro local de skills (lo genera sdd-init)
.atl/

# Evidencia de QA (capturas/videos/PDF): pesa cientos de MB y no se commitea.
# Los informes .md/.json y el README se siguen versionando. Para salida nueva
# usá MOBOS_QA_OUT o test-results/.
/docs/qa/**/*.png
/docs/qa/**/*.jpg
/docs/qa/**/*.jpeg
/docs/qa/**/*.webp
/docs/qa/**/*.gif
/docs/qa/**/*.webm
/docs/qa/**/*.mp4
/docs/qa/**/*.pdf
/docs/qa/**/*.har
/docs/qa/**/*.zip
