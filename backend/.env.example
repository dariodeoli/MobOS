# PostgreSQL connection string. Set this locally; never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Used by the standalone Next.js API.
API_URL=http://localhost:3001
# Canonical production API: https://api.moboss.online

# Google OAuth: server only. Real values belong in private Hub variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
MOBOS_APP_URL=http://localhost:5175
# Origen opcional del instalador del agente (default: el origen del API, que es
# quien sirve /print-agent/install.sh). Solo para proxies/CDN propios.
MOBOS_PRINT_INSTALL_BASE=
# Production callback: https://api.moboss.online/api/auth/google/callback
# Production app origin: https://app.moboss.online
# Independent MobOS key: 32 random bytes encoded as 64 hex characters.
MOBOS_AUTH_SECRET=

# Authenticated transactional-email relay. MobOS never receives a provider key.
WEEM_EMAIL_RELAY_URL=
WEEM_EMAIL_RELAY_TOKEN=

# Server-only AES-256-GCM key ring for pending outbox payloads. Values are 32 random bytes in base64.
MOBOS_EMAIL_OUTBOX_ACTIVE_KEY_ID=
MOBOS_EMAIL_OUTBOX_ENCRYPTION_KEYS_JSON={}

# Private bearer used by the scheduler to process pending transactional email.
MOBOS_MAINTENANCE_TOKEN=

# AEX (envíos): credenciales opcionales para cotizar, generar guías y seguir
# envíos. Las direcciones usan siempre el catálogo local de municipios.
# Real values belong in private Hub variables; never commit them.
# Pruebas: https://sandbox.aex.com.py/api/v1 · Producción: https://aex.com.py/api/v1
MOBOS_AEX_PUBLIC_KEY=
MOBOS_AEX_PRIVATE_KEY=
MOBOS_AEX_API_URL=https://aex.com.py/api/v1
# Webhook de seguimiento: token acordado con AEX y header donde llega
# (por defecto Authorization: Bearer <token>). Sin token se acepta, para sandbox.
MOBOS_AEX_WEBHOOK_TOKEN=
MOBOS_AEX_WEBHOOK_HEADER=authorization

# Volumen persistente para adjuntos (comprobantes y fotos). Si queda vacío, los
# bytes se guardan solo en la columna ByteA; con valor, cada archivo va a
# ${MOBOS_STORAGE_DIR}/<tenant>/<area>/<uuid>.<ext> y la base conserva el respaldo.
MOBOS_STORAGE_DIR=
