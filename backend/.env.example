# PostgreSQL connection string. Set this locally; never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Used by the standalone Next.js API.
API_URL=http://localhost:3001

# Google OAuth: server only. Real values belong in private Hub variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
MOBOS_APP_URL=http://localhost:5173
# Independent MobOS key: 32 random bytes encoded as 64 hex characters.
MOBOS_AUTH_SECRET=
