# PostgreSQL connection string. Set this locally; never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Used by the standalone Next.js API.
API_URL=http://localhost:3001
# Canonical production API: https://api.moboss.online

# Google OAuth: server only. Real values belong in private Hub variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
MOBOS_APP_URL=http://localhost:5175
# Production callback: https://api.moboss.online/api/auth/google/callback
# Production app origin: https://app.moboss.online
# Independent MobOS key: 32 random bytes encoded as 64 hex characters.
MOBOS_AUTH_SECRET=

# Authenticated transactional-email relay. MobOS never receives a provider key.
WEEM_EMAIL_RELAY_URL=
WEEM_EMAIL_RELAY_TOKEN=

# Server-only AES-256-GCM key ring for pending outbox payloads. Values are 32 random bytes in base64.
MOBOS_EMAIL_OUTBOX_ACTIVE_KEY_ID=
MOBOS_EMAIL_OUTBOX_ENCRYPTION_KEYS_JSON={}

# Private bearer used by the scheduler to process pending transactional email.
MOBOS_MAINTENANCE_TOKEN=
