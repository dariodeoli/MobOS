generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  googleIdentity GoogleIdentity?
  promotions Promotion[]
  paymentAccounts PaymentAccount[]
  tradeInDevices TradeInDevice[]
  cashSessions CashSession[]
  purchases PurchaseOrder[]
  warrantyCases WarrantyCase[]
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  passwordHash String?
  failedLoginAttempts Int @default(0)
  lockedUntil DateTime?
  slug      String   @unique
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches  Branch[]
  users     User[]
  sessions  Session[]
  products  Product[]
  customers Customer[]
  orders    Order[]
  payments  Payment[]
  paymentProofs PaymentProof[]
  paymentReconciliations PaymentReconciliation[]
  auditLogs AuditLog[]
}

model GoogleIdentity {
  subject String @id
  tenantId String @unique
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Branch {
  tradeInDevices TradeInDevice[]
  cashSessions CashSession[]
  purchases PurchaseOrder[]
  warrantyCases WarrantyCase[]
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  city      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  products Product[]
  orders   Order[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model User {
  openedCashSessions CashSession[] @relation("CashOpenedBy")
  closedCashSessions CashSession[] @relation("CashClosedBy")
  purchases PurchaseOrder[]
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name      String
  email     String?
  pinHash   String
  role      UserRole   @default(VENDEDOR)
  status    UserStatus @default(ACTIVE)
  failedLoginAttempts Int @default(0)
  lockedUntil DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  orders    Order[]
  auditLogs AuditLog[]
  uploadedPaymentProofs PaymentProof[] @relation("PaymentProofUploader")
  verifiedPaymentReconciliations PaymentReconciliation[] @relation("PaymentReconciliationVerifier")

  sessions Session[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([branchId])
}

model Session {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     SessionLevel @default(COMPANY)
  deviceId  String
  branchId  String?
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([tenantId, userId])
  @@index([expiresAt])
}

enum SessionLevel {
  COMPANY
  SELLER
}

enum UserRole {
  ADMIN
  GERENTE
  VENDEDOR
  CAJERA
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Product {
  tradeInDevice TradeInDevice?
  destination ProductDestination @default(NORMAL)
  purchaseLines PurchaseLine[]
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sku       String
  name      String
  category  String?
  imei      String?
  condition ProductCondition @default(NEW)
  pricePyg  Int
  costPyg   Int?
  stock     Int           @default(0)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  orderItems OrderItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, branchId])
  @@index([tenantId, imei])
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  document  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([tenantId])
  @@index([tenantId, phone])
}

model Order {
  tradeInDevices TradeInDevice[]
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sellerId    String
  seller      User        @relation(fields: [sellerId], references: [id])
  orderNumber String
  status      OrderStatus @default(PENDING)
  subtotalPyg Int
  discountPyg Int @default(0)
  deliveryPyg Int @default(0)
  deliveryType String?
  deliveryNotes String?
  totalPyg    Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([branchId])
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model OrderItem {
  promotionSnapshot Json?
  warrantyCases WarrantyCase[]
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  quantity    Int     @default(1)
  unitPricePyg Int
  unitCostPyg Int?
  totalPyg    Int

  @@index([orderId])
}

model Promotion {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code String
  name String
  kind String
  value Int
  productId String?
  startsAt DateTime
  endsAt DateTime
  maxUnits Int?
  usedUnits Int @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, code])
}

model Payment {
  accountId String?
  account PaymentAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  accountSnapshot Json?
  currency PaymentCurrency?
  originalAmount Decimal? @db.Decimal(18, 2)
  exchangeRatePyg Decimal? @db.Decimal(18, 6)
  tradeInDevice TradeInDevice?
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method     PaymentMethod
  status     PaymentStatus @default(CONFIRMED)
  amountPyg  Int
  reference  String?
  idempotencyKey String?
  paidAt     DateTime      @default(now())
  createdAt  DateTime      @default(now())

  proofs         PaymentProof[]
  reconciliation PaymentReconciliation?

  @@index([tenantId])
  @@index([orderId])
  @@unique([tenantId, idempotencyKey])
}

model PaymentProof {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentId    String
  payment      Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  sizeBytes    Int
  sha256       String
  data         Bytes    @db.ByteA
  uploadedById String
  uploadedBy   User     @relation("PaymentProofUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([tenantId, paymentId, createdAt])
  @@index([uploadedById, createdAt])
}

model PaymentReconciliation {
  id           String             @id @default(cuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentId    String             @unique
  payment      Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  state        ReconciliationState @default(PENDING)
  note         String?
  verifiedById String?
  verifiedBy   User?              @relation("PaymentReconciliationVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([tenantId, state])
  @@index([verifiedById, updatedAt])
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  CREDIT
  TRADE_IN
}

enum PaymentCurrency {
  PYG
  USD
}

enum PaymentAccountKind {
  CASH
  TRANSFER
  CARD
  TRADE_IN
}

enum ProductDestination {
  NORMAL
  OFFER
  WHOLESALE
}

enum TradeInStatus {
  RECEIVED
  REVIEW
  REPAIR
  READY
  STOCK
  SOLD_EXTERNAL
}

model PaymentAccount {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name String
  bank String?
  holder String?
  accountNumber String?
  currency PaymentCurrency
  kind PaymentAccountKind
  isActive Boolean @default(true)
  feePercent Decimal @default(0) @db.Decimal(5, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payments Payment[]
  @@index([tenantId, isActive])
}

model TradeInDevice {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId String?
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId String @unique
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  serial String
  model String
  conditionNotes String
  valuePyg Int
  status TradeInStatus @default(RECEIVED)
  repairCostPyg Int @default(0)
  notes String?
  productId String? @unique
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, serial])
  @@index([tenantId, branchId, status])
  @@index([orderId])
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
  REFUNDED
}

enum ReconciliationState {
  PENDING
  VERIFIED
  REJECTED
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entity     String
  entityId   String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
}

model CashSession {
  id String @id
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId String
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  openedById String
  openedBy User @relation("CashOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedById String?
  closedBy User? @relation("CashClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  openedAt DateTime @default(now())
  closedAt DateTime?
  openingPyg Int
  countedPyg Int?
  expectedPyg Int?
  status String @default("OPEN")
  notes String?
  // Una caja abierta por sucursal: índice parcial definido en la migración SQL.
  @@index([tenantId, branchId, openedAt])
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
}

model PurchaseOrder {
  id String @id
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId String?
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplierName String
  status PurchaseStatus @default(DRAFT)
  createdAt DateTime @default(now())
  receivedAt DateTime?
  createdById String
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  shippingPyg Int @default(0)
  customsPyg Int @default(0)
  lines PurchaseLine[]
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

model PurchaseLine {
  id String @id
  purchaseId String
  purchase PurchaseOrder @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity Int
  unitCostPyg Int
  @@index([purchaseId])
  @@index([productId])
}

enum WarrantyStatus {
  RECEIVED
  DIAGNOSIS
  READY
  DELIVERED
}

model WarrantyCase {
  id String @id
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId String
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  orderItemId String?
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  customerName String
  serial String
  description String
  status WarrantyStatus @default(RECEIVED)
  responsibleName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  expiresAt DateTime?
  @@index([tenantId, createdAt])
  @@index([tenantId, serial])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
}
