generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  presenceTabs        PresenceTab[]
  usageSessions       UsageSession[]
  googleStoreAccesses GoogleStoreAccess[]
  promotions          Promotion[]
  logos                 TenantLogo[]
  paymentAccounts     PaymentAccount[]
  tradeInDevices      TradeInDevice[]
  deviceValuations    DeviceValuation[]
  cashSessions        CashSession[]
  purchases           PurchaseOrder[]
  purchaseReturns     PurchaseReturn[]
  purchaseReturnLines PurchaseReturnLine[]
  suppliers           Supplier[]
  warrantyCases       WarrantyCase[]
  cashMovements       CashMovement[]
  id                  String           @id @default(cuid())
  name                String
  email               String?          @unique
  emailVerifiedAt     DateTime?
  welcomeEmailSentAt  DateTime?
  passwordHash        String?
  failedLoginAttempts Int              @default(0)
  lockedUntil         DateTime?
  archivedAt          DateTime?
  archivedReason      String?
  // Hasta cuándo el dueño puede restaurar la empresa archivada desde la app.
  recoverableUntil    DateTime?
  slug                String           @unique
  // Identificador comercial visible de los pedidos: "MOB #310840".
  orderPrefix         String?
  orderNextNumber     Int?
  // Umbrales de autorización: gasto y compra a crédito sin autorización de
  // gerencia para los roles operativos. Null usa el default de la aplicación.
  expenseLimitPyg        Int?
  purchaseCreditLimitPyg Int?
  // Porcentaje de venta bajo lista permitido sin autorización (default 10).
  belowListPct           Int?
  // Seguro predeterminado de la empresa (#162): porcentaje sobre el costo del
  // producto que se suma al costo real de cada venta para el margen. Null o 0
  // lo desactiva; el seguro del producto o de la categoría tiene prioridad.
  insurancePct           Int?
  // Fidelización: porcentaje del total de cada venta que se acredita como
  // puntos canjeables (1 punto = 1 Gs.). 0 apaga la fidelización.
  loyaltyPct             Int              @default(0)
  // Recargo diario por mora en puntos básicos (100 bp = 1 % por día de atraso).
  // Null o 0 = sin recargo: solo se informan los días de atraso. Se configura
  // en Configuración → Negocio y es reversible (vaciar el campo lo desactiva).
  collectionLateFeeBpPerDay Int?
  // Perfil del negocio que encabeza los comprobantes no fiscales.
  address                String?
  city                   String?
  department             String?
  phone                  String?
  ruc                    String?
  settings            Json             @default("{}")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  branches                Branch[]
  users                   User[]
  sessions                Session[]
  products                Product[]
  customers               Customer[]
  orders                  Order[]
  orderAccessTokens       OrderAccessToken[]
  payments                Payment[]
  paymentProofs           PaymentProof[]
  paymentReconciliations  PaymentReconciliation[]
  reconciliationBatches   ReconciliationBatch[]
  orderComments           OrderComment[]
  marketingCampaigns      MarketingCampaign[]
  quotes                  Quote[]
  combos                  Combo[]
  orderCommentPhotos      OrderCommentPhoto[]
  inventoryUnitComments   InventoryUnitComment[]
  inventoryUnitCommentPhotos InventoryUnitCommentPhoto[]
  attachments             Attachment[]
  auditLogs               AuditLog[]
  inventoryUnits          InventoryUnit[]
  stockTransfers          StockTransfer[]
  costPolicies            CostPolicy[]
  stockVisibilityGranted  InventoryVisibilityGrant[] @relation("StockVisibilityProvider")
  stockVisibilityReceived InventoryVisibilityGrant[] @relation("StockVisibilityRecipient")
  stockLocations          StockLocation[]
  messageTemplates        MessageTemplate[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  userInvitations         UserInvitation[]
  emailOutboxJobs         EmailOutbox[]
  authAttempts            AuthAttempt[]
  errorReports            ErrorReport[]
  customerNotes           CustomerNote[]
  customerFollowUps       CustomerFollowUp[]
  customerNotices         CustomerNotice[]
  commissionRules         CommissionRule[]
  warrantyPhotos          WarrantyPhoto[]
  customerAuthorizations  CustomerAuthorization[]
  customerBillingIdentities CustomerBillingIdentity[]
  deviceReportShares      DeviceReportShare[]
  printBridges            PrintBridge[]
  printers                PrintPrinter[]
  printJobs               PrintJob[]
  customerPortalTokens    CustomerPortalToken[]
  priceLists              PriceList[]
  storeCredits            StoreCredit[]
  storeCreditUses         StoreCreditUse[]
  loyaltyMovements        LoyaltyMovement[]
  inventoryCounts         InventoryCount[]
  inventoryCountLines     InventoryCountLine[]
  suspendedSales          SuspendedSale[]
  commissionSettlements   CommissionSettlement[]
  deliverySettlements     DeliverySettlement[]
  sifenDocuments          SifenDocument[]
  privateCompanies        PrivateCompany[]
  accountHolders          AccountHolder[]
  cashAuditMarks          CashAuditMark[]

  @@index([archivedAt])
  supplyNeeds                 SupplyNeed[]
  supplyPurchases             SupplyPurchase[]
  supplyPurchaseLines         SupplyPurchaseLine[]
  supplyPurchaseSerials       SupplyPurchaseSerial[]
  supplyShipments             SupplyShipment[]
  supplyShipmentItems         SupplyShipmentItem[]
}

// Identidad de la PERSONA (cuenta Google). No pertenece a ninguna tienda:
// la relación persona ↔ tienda vive en GoogleStoreAccess.
model GoogleIdentity {
  subject String  @id
  name    String?
  picture String?
  stores  GoogleStoreAccess[]
}

// Acceso de una persona Google a una tienda. El dueño de la tienda es la
// persona con owner=true; puede haber varios accesos (uno por tienda).
model GoogleStoreAccess {
  subject   String
  identity  GoogleIdentity @relation(fields: [subject], references: [subject], onDelete: Cascade)
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner     Boolean        @default(true)
  createdAt DateTime       @default(now())

  @@id([subject, tenantId])
  @@index([tenantId])
}

// Tokens de recuperación de contraseña de la empresa. Solo se almacena su
// hash y cada uso invalida todos los tokens anteriores de la misma empresa.
model PasswordResetToken {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([tenantId, expiresAt])
}

model EmailVerificationToken {
  id        String          @id @default(cuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purpose   AuthTokenPurpose @default(EMAIL_VERIFICATION)
  tokenHash String          @unique
  expiresAt DateTime
  sentAt    DateTime
  consumedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime        @default(now())

  @@index([tenantId, purpose, expiresAt])
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
}

// Ventana persistente de intentos sensibles por origen pseudonimizado. No se
// conserva una IP ni un correo en claro: el fingerprint se deriva en servidor.
model AuthAttempt {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scope       String
  fingerprint String
  createdAt   DateTime @default(now())

  @@index([scope, fingerprint, createdAt])
  @@index([tenantId, createdAt])
}

// Errores reportados por clientes vía POST /api/errors. Los registros sin
// tenant corresponden a errores previos al login; el stack solo se expone al
// propio tenant en la vista de detalle.
model ErrorReport {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestId String?
  kind      String   @default("unhandled")
  message   String
  url       String?
  stack     String?  @db.Text
  userAgent String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// Catálogo de ciudades y departamentos de Paraguay, sembrado por migración,
// para no depender de APIs externas en el autocompletado.
model GeoCity {
  id         String   @id @default(cuid())
  name       String
  department String
  createdAt  DateTime @default(now())

  @@unique([name, department])
}

model Branch {
  tradeInDevices TradeInDevice[]
  cashSessions   CashSession[]
  purchases      PurchaseOrder[]
  warrantyCases  WarrantyCase[]
  cashMovements  CashMovement[]
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  city           String?
  department     String?
  phone          String?
  instagram      String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  users             User[]
  userInvitations   UserInvitation[]
  products          Product[]
  orders            Order[]
  inventoryUnits    InventoryUnit[]
  stockLocations    StockLocation[]
  outgoingTransfers StockTransfer[] @relation("TransferSourceBranch")
  incomingTransfers StockTransfer[] @relation("TransferDestinationBranch")
  quotes            Quote[]
  combos            Combo[]
  inventoryCounts   InventoryCount[]
  suspendedSales    SuspendedSale[]
  deliverySettlements DeliverySettlement[]

  @@unique([tenantId, name])
  @@index([tenantId])
  printBridges   PrintBridge[]  @relation("PrintBridgeBranch")
  printPrinters  PrintPrinter[] @relation("PrintPrinterBranch")
  supplyNeeds SupplyNeed[]
  supplyPurchases SupplyPurchase[]
  supplyShipments SupplyShipment[] @relation("SupplyShipmentDestination")
}

model User {
  presenceTabs        PresenceTab[]
  usageSessions       UsageSession[]
  avatar              UserAvatar?
  openedCashSessions  CashSession[]   @relation("CashOpenedBy")
  inventoryVerifications InventoryUnit[] @relation("InventoryUnitVerifier")
  closedCashSessions  CashSession[]   @relation("CashClosedBy")
  orderComments       OrderComment[]
  quotes              Quote[]
  inventoryUnitComments InventoryUnitComment[]
  purchases           PurchaseOrder[]
  suspendedSales      SuspendedSale[]
  id                  String          @id @default(cuid())
  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId            String?
  branch              Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name                String
  email               String?
  pinHash             String
  // Largo del PIN (4-6). Null en usuarios viejos: se asume 4 para el auto-envío.
  pinLength           Int?
  role                UserRole        @default(VENDEDOR)
  status              UserStatus      @default(ACTIVE)
  // Subconjunto opcional del rol: restringe, nunca amplía permisos.
  permissions         Json?
  // Horario semanal opcional, expresado en una zona IANA. Null = sin restricción.
  accessSchedule      Json?
  failedLoginAttempts Int             @default(0)
  lockedUntil         DateTime?
  lastAccessAt        DateTime?
  // Meta diaria de venta en guaraníes: se compara contra lo vendido hoy.
  dailyGoalPyg        Int?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  orders                         Order[]
  auditLogs                      AuditLog[]
  uploadedPaymentProofs          PaymentProof[]          @relation("PaymentProofUploader")
  attachmentsCreated             Attachment[]            @relation("AttachmentCreatedBy")
  verifiedPaymentReconciliations PaymentReconciliation[] @relation("PaymentReconciliationVerifier")
  reconciliationBatchesCreated  ReconciliationBatch[]   @relation("ReconciliationBatchCreatedBy")

  sessions         Session[]
  createdTransfers StockTransfer[]
  customerNotes    CustomerNote[]
  customerFollowUps CustomerFollowUp[]
  customerNotices  CustomerNotice[]
  customersCreated Customer[]      @relation("CustomerCreatedBy")
  paymentsCreated Payment[]        @relation("PaymentCreatedBy")
  customerAuthorizationsRequested CustomerAuthorization[] @relation("CustomerAuthorizationRequestedBy")
  customerAuthorizationsResolved  CustomerAuthorization[] @relation("CustomerAuthorizationResolvedBy")
  commissionRules  CommissionRule[]
  commissionSettlementsAsSeller CommissionSettlement[] @relation("CommissionSettlementSeller")
  commissionSettlementsCreated  CommissionSettlement[] @relation("CommissionSettlementCreatedBy")
  commissionSettlementsPaid     CommissionSettlement[] @relation("CommissionSettlementPaidBy")
  invitationsSent UserInvitation[] @relation("InvitationInviter")
  printBridgesCreated PrintBridge[] @relation("PrintBridgeCreatedBy")
  printJobsRequested  PrintJob[]    @relation("PrintJobRequestedBy")
  cashAuditMarks      CashAuditMark[] @relation("CashAuditAuditedBy")
  ordersAssigned      Order[]       @relation("OrderDeliveryAssignedTo")
  paymentsCollected   Payment[]     @relation("PaymentCollectedBy")
  deliverySettlementsRendered DeliverySettlement[] @relation("DeliverySettlementRenderedBy")
  deliverySettlementsVerified DeliverySettlement[] @relation("DeliverySettlementVerifiedBy")
  marketingCampaigns          MarketingCampaign[]   @relation("MarketingCampaignCreatedBy")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, status, lockedUntil])
  supplyNeedsAssigned           SupplyNeed[] @relation("SupplyNeedAssignee")
  supplyNeedsCreated            SupplyNeed[] @relation("SupplyNeedAuthor")
  supplyPurchasesCreated        SupplyPurchase[] @relation("SupplyPurchaseAuthor")
  supplyShipmentsResponsible   SupplyShipment[] @relation("SupplyShipmentResponsible")
  supplyShipmentsCreated       SupplyShipment[] @relation("SupplyShipmentAuthor")
}

model UserInvitation {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email             String
  name              String
  role              UserRole  @default(VENDEDOR)
  branchId          String?
  branch            Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  permissions       Json?
  inviterId         String
  inviter           User      @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Restrict)
  tokenHash         String    @unique
  expiresAt         DateTime
  sentAt            DateTime
  resendAvailableAt DateTime
  consumedAt        DateTime?
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId, email])
  @@index([tenantId, expiresAt])
}

// Durable handoff between credential state changes and the external relay.
// Payloads are dispatched only after their creating transaction commits.
model EmailOutbox {
  // Generated by the application and reused as the provider idempotency identity.
  id             String    @id
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind           String
  recipient      String
  // AES-256-GCM envelope; see AUTH-CONFIG.md. Scrubbed after terminal completion.
  payload        String    @db.Text
  idempotencyKey String    @unique
  aggregateType  String
  aggregateId    String
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now())
  lockedAt       DateTime?
  sentAt         DateTime?
  cancelledAt    DateTime?
  failedAt       DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([sentAt, cancelledAt, failedAt, availableAt, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([tenantId, createdAt])
}

model Session {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  level      SessionLevel @default(COMPANY)
  deviceId   String
  branchId   String?
  tokenHash  String       @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  // Reautenticación sensible de corta duración para exportar, revocar o archivar.
  reauthenticatedAt DateTime?
  createdAt  DateTime     @default(now())
  lastSeenAt DateTime     @default(now())

  @@index([tenantId, userId])
  @@index([expiresAt])
  @@index([tenantId, reauthenticatedAt])
}

enum SessionLevel {
  COMPANY
  SELLER
}

enum UserRole {
  ADMIN
  GERENTE
  VENDEDOR
  CAJERA
  TECNICO
  REPARTIDOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Product {
  tradeInDevice TradeInDevice?
  destination   ProductDestination @default(NORMAL)
  purchaseLines PurchaseLine[]
  purchaseReturnLines PurchaseReturnLine[]
  id            String             @id @default(cuid())
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sku           String
  name          String
  category      String?
  // Variante estructurada del catálogo (se completan solas desde el nombre
  // cuando el producto incluye capacidad; editables a mano).
  model         String?
  color         String?
  capacity      String?
  imei          String?
  condition     ProductCondition   @default(NEW)
  pricePyg      Int
  // Precio para clientes mayoristas; si es null, se usa pricePyg.
  wholesalePricePyg Int?
  // Precio en dólares (opcional) para ventas/cotizaciones en USD.
  priceUsd          Decimal?           @db.Decimal(14, 2)
  // Garantía automática al vender: días, cobertura y exclusiones.
  warrantyDays      Int?
  warrantyCoverage  String?
  warrantyExclusions String?
  costPyg       Int?
  // Si tiene valor, prevalece sobre la política de la categoría.
  insuranceRate Decimal?           @db.Decimal(5, 2)
  stock         Int                @default(0)
  // Umbral de reposición opcional: stock <= reorderPoint dispara la alerta.
  // 0 o null = sin alerta para ese producto.
  reorderPoint  Int?
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  orderItems               OrderItem[]
  inventoryUnits           InventoryUnit[]
  transferSourceLines      StockTransferLine[] @relation("TransferSourceProduct")
  transferDestinationLines StockTransferLine[] @relation("TransferDestinationProduct")
  priceListItems           PriceListItem[]
  inventoryCountLines      InventoryCountLine[]

  @@unique([tenantId, branchId, sku])
  @@index([tenantId, branchId])
  @@index([tenantId, imei])
  // Búsqueda difusa por nombre (pg_trgm, GIN): ILIKE '%texto%' sin escanear.
  @@index([name(ops: raw("gin_trgm_ops"))], map: "Product_name_trgm_idx", type: Gin)
  @@index([sku(ops: raw("gin_trgm_ops"))], map: "Product_sku_trgm_idx", type: Gin)
  @@index([model(ops: raw("gin_trgm_ops"))], map: "Product_model_trgm_idx", type: Gin)
  @@index([capacity(ops: raw("gin_trgm_ops"))], map: "Product_capacity_trgm_idx", type: Gin)
  @@index([color(ops: raw("gin_trgm_ops"))], map: "Product_color_trgm_idx", type: Gin)
  @@index([imei(ops: raw("gin_trgm_ops"))], map: "Product_imei_trgm_idx", type: Gin)
  supplyNeeds SupplyNeed[]
  supplyPurchaseLines SupplyPurchaseLine[]
  supplyShipmentItems SupplyShipmentItem[]
}

enum InventoryUnitStatus {
  AVAILABLE
  RESERVED
  SOLD
  DEFECTIVE
  IN_TRANSIT
}

// Conteo físico auditable: documento con las unidades escaneadas en una
// sucursal, las diferencias contra el sistema y la aprobación de gerencia.
// Aplicarlo da de baja (defectuoso) lo que no apareció y queda en auditoría.
enum InventoryCountStatus {
  DRAFT
  APPLIED
  CANCELLED
}

model InventoryCount {
  id          String               @id @default(cuid())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  status      InventoryCountStatus @default(DRAFT)
  note        String?
  createdById String
  appliedById String?
  appliedAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  lines       InventoryCountLine[]

  @@index([tenantId, branchId, status])
  @@index([tenantId, createdAt])
}

model InventoryCountLine {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  countId     String
  count       InventoryCount  @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  // IMEI/serial escaneado. Null en productos sin serie (se cuenta por cantidad).
  serial      String?
  quantity    Int             @default(1)
  // La unidad ya estaba AVAILABLE en la sucursal al contar (lo esperado).
  expected    Boolean         @default(false)
  scannedById String
  createdAt   DateTime        @default(now())

  @@unique([countId, serial])
  @@index([countId])
}

model InventoryUnit {
  id                  String              @id @default(cuid())
  tenantId            String
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId           String
  product             Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  branchId            String?
  branch              Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  locationId          String?
  location            StockLocation?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  serial              String
  supplierId          String?
  supplier            Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  comments            InventoryUnitComment[]
  // Un único modelo puede tener unidades nuevas o seminuevas con historial propio.
  // Esto evita crear un producto distinto por cada IMEI.
  condition           ProductCondition    @default(NEW)
  batteryHealth       Int?
  supplierName        String?
  purchasedAt         DateTime?
  costPyg             Int?
  costCurrency        PaymentCurrency     @default(PYG)
  originalCost        Decimal?            @db.Decimal(14, 2)
  exchangeRatePyg     Decimal?            @db.Decimal(14, 4)
  notes               String?
  // Consignación de terceros: el equipo no es de la tienda. Al venderse se le
  // paga al consignador el monto acordado.
  consignorName       String?
  consignorPhone      String?
  consignorPyg        Int?
  reservedUntil       DateTime?
  // Nombre congelado al reservar (lo que se muestra) y la ficha real del
  // cliente cuando la reserva se hizo eligiendo uno existente.
  reservationCustomer String?
  reservationCustomerId String?
  reservationCustomerRef Customer? @relation("InventoryUnitReservation", fields: [reservationCustomerId], references: [id], onDelete: SetNull)
  reservedById        String?
  lastVerifiedAt      DateTime?
  lastVerifiedById    String?
  verificationCount   Int                 @default(0)
  // Código de la verificación física del vendedor (ej. VPC/VPM/VPE/VPS).
  verifiedByCode      String?
  lastVerifiedBy      User?             @relation("InventoryUnitVerifier", fields: [lastVerifiedById], references: [id], onDelete: SetNull)
  status              InventoryUnitStatus @default(AVAILABLE)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([tenantId, serial])
  @@index([tenantId, productId, status])
  @@index([serial(ops: raw("gin_trgm_ops"))], map: "InventoryUnit_serial_trgm_idx", type: Gin)
  @@index([tenantId, branchId, status])
  @@index([tenantId, status, reservedUntil])
  @@index([tenantId, branchId, locationId, status])
  @@index([tenantId, branchId, lastVerifiedAt])
  @@index([tenantId, supplierId])
  @@index([reservationCustomerId])
  inspection Json?
}

// Ubicación física dentro de una sucursal: piso de venta, depósito, vitrina,
// recepción, etc. No es una sucursal nueva y no puede cruzar empresas.
model StockLocation {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name           String
  code           String?
  color       String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  inventoryUnits InventoryUnit[]

  @@unique([branchId, name])
  @@unique([branchId, code])
  @@index([tenantId, branchId, isActive])
}

// Permiso explícito y solo de lectura: el receptor ve disponibilidad, nunca
// costos, IMEI, clientes o movimientos de la empresa proveedora.
model InventoryVisibilityGrant {
  id                String   @id @default(cuid())
  providerTenantId  String
  providerTenant    Tenant   @relation("StockVisibilityProvider", fields: [providerTenantId], references: [id], onDelete: Cascade)
  recipientTenantId String
  recipientTenant   Tenant   @relation("StockVisibilityRecipient", fields: [recipientTenantId], references: [id], onDelete: Cascade)
  createdById       String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([providerTenantId, recipientTenantId])
  @@index([recipientTenantId, isActive])
  @@index([providerTenantId, isActive])
}

model StockTransfer {
  id                  String              @id @default(cuid())
  tenantId            String
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceBranchId      String
  sourceBranch        Branch              @relation("TransferSourceBranch", fields: [sourceBranchId], references: [id], onDelete: Restrict)
  destinationBranchId String
  destinationBranch   Branch              @relation("TransferDestinationBranch", fields: [destinationBranchId], references: [id], onDelete: Restrict)
  createdById         String
  createdBy           User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  notes               String?
  // Guía de envío AEX cuando el traslado viaja con transportadora: se adjunta
  // al despachar y habilita el seguimiento por API.
  aexGuide            String?
  // Acceso público del remito: token no enumerable que viaja en el QR impreso
  // y permite confirmar la recepción física sin sesión.
  publicToken         String?             @unique @default(cuid())
  // Se completa cuando todas las unidades del traslado llegaron a destino.
  receivedAt          DateTime?
  // Quién y con qué nota confirmó la recepción (null en el flujo público).
  receivedById        String?
  receivedNote        String?
  createdAt           DateTime            @default(now())
  lines               StockTransferLine[]

  @@index([tenantId, sourceBranchId, createdAt])
  @@index([tenantId, destinationBranchId, createdAt])
}

// Eventos que AEX notifica por webhook para cada guía. Se guardan para mostrar
// el seguimiento sin depender del polling a la API. Sin relaciones: la guía
// puede no corresponder a un traslado propio y el evento igual se audita.
model AexWebhookEvent {
  id               String    @id @default(cuid())
  tenantId         String?
  transferId       String?
  guia             String
  codigoEstado     String?
  estado           String?
  codigoTipoEvento String?
  tipoEvento       String?
  observacion      String?
  codigoOperacion  String?
  fechaEvento      DateTime?
  recibidoEn       DateTime  @default(now())

  @@index([guia, fechaEvento])
  @@index([tenantId])
}

model StockTransferLine {
  id                   String        @id @default(cuid())
  transferId           String
  transfer             StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  sourceProductId      String
  sourceProduct        Product       @relation("TransferSourceProduct", fields: [sourceProductId], references: [id], onDelete: Restrict)
  destinationProductId String
  destinationProduct   Product       @relation("TransferDestinationProduct", fields: [destinationProductId], references: [id], onDelete: Restrict)
  quantity             Int
  serials              Json          @default("[]")

  @@index([transferId])
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

model Customer {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  // Nombres desdoblados (#160): `name` sigue siendo el nombre completo visible
  // y la búsqueda; estas partes permiten el trato y el saludo.
  firstName   String?
  secondName  String?
  phone       String?
  countryCode String   @default("+595")
  email       String?
  document    String?
  // Datos de facturación habituales (factura a otro titular): se recuerdan
  // desde la última venta y la búsqueda de clientes los incluye.
  billingName     String?
  billingDocument String?
  notes       String?
  // Nota que sí puede mostrarse al cliente (comprobantes, mensajes, QR).
  publicNote  String?
  // Identificador del cliente en un sistema anterior (migración de datos):
  // permite importar fichas históricas sin duplicar personas.
  externalId  String?
  // Usuario que dio de alta la ficha (null = importada o creada por sistema).
  createdById String?
  // Precio minorista o mayorista; el mayorista usa wholesalePricePyg del producto.
  pricingTier CustomerPricing @default(RETAIL)
  // Lista de precios negociada (opcional): reemplaza al precio mayorista fijo
  // cuando el ítem de la lista alcanza al producto o a su categoría.
  priceListId String?
  priceList   PriceList?     @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  // Límite de crédito en guaraníes (null = sin venta a crédito).
  creditLimitPyg Int?
  // Plazo de crédito estándar en días para este cliente.
  creditDays Int?
  // Seguro del cliente (#160): con el toggle activo, sus ventas usan su
  // porcentaje o el default de la empresa (FIN #162); impacta el costo real y
  // el margen. `insuranceRatePct` null = hereda el default de la empresa.
  insuranceEnabled  Boolean @default(false)
  insuranceRatePct  Decimal? @db.Decimal(5, 2)
  // Caché del saldo de puntos de fidelización (1 punto = 1 Gs. canjeable);
  // el detalle reconstruible vive en LoyaltyMovement.
  loyaltyPointsPyg Int @default(0)
  // Consentimientos de marketing explícitos; por defecto apagados.
  acceptsEmailMarketing     Boolean  @default(false)
  acceptsSmsMarketing       Boolean  @default(false)
  acceptsWhatsappMarketing  Boolean  @default(false)
  // Última campaña de marketing registrada para esta ficha: la vista de
  // inactivos no repite el envío hasta que pase la ventana de enfriamiento.
  marketingContactedAt      DateTime?
  taxExempt                 Boolean  @default(false)
  tags                      String[] @default([])
  // Último contacto de una campaña de marketing (recompra, saldo, etc.):
  // evita mandarle el mismo mensaje dos veces a la misma persona.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders        Order[]
  quotes        Quote[]
  unitReservations InventoryUnit[] @relation("InventoryUnitReservation")
  warrantyCases WarrantyCase[] @relation("WarrantyCaseCustomer")
  serviceOrders ServiceOrder[] @relation("ServiceOrderCustomer")
  addresses     CustomerAddress[]
  customerNotes CustomerNote[]
  followUps     CustomerFollowUp[]
  customerNotices CustomerNotice[]
  createdBy     User?             @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  authorizations    CustomerAuthorization[]
  billingIdentities CustomerBillingIdentity[]
  portalTokens      CustomerPortalToken[]
  storeCredits      StoreCredit[]
  loyaltyMovements  LoyaltyMovement[]
  suspendedSales    SuspendedSale[]
  marketingRecipients MarketingRecipient[]
  deviceReportShares DeviceReportShare[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([tenantId, externalId])
  @@index([priceListId])
  // Búsqueda difusa por nombre (pg_trgm, GIN): ILIKE '%texto%' sin escanear.
  @@index([name(ops: raw("gin_trgm_ops"))], map: "Customer_name_trgm_idx", type: Gin)
  supplyNeeds SupplyNeed[]
}

// Solicitud de autorización comercial (mayorista, crédito, plazo o descuento).
// La pide cualquier vendedor y la resuelve administración/gerencia; lo
// autorizado puede diferir de lo pedido (p. ej. menos días de crédito o un
// máximo de descuento menor). Un descuento no exige cliente: cubre la venta.
model CustomerAuthorization {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind           String    // WHOLESALE | CREDIT | CREDIT_DAYS | DISCOUNT | STOCK_ADJUST | ORDER_VOID | BELOW_LIST_PRICE
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED
  // Sujeto afectado por la autorización (unidad, pedido, producto). Null en
  // las condiciones comerciales del cliente, donde el sujeto es la ficha.
  entity         String?   // INVENTORY_UNIT | ORDER | PRODUCT
  entityId       String?
  requestedValue Json?     // CREDIT: { creditLimitPyg, creditDays } · CREDIT_DAYS: { creditDays } · DISCOUNT: { discountPyg } · STOCK_ADJUST: { unitId, action, reason, stock } · ORDER_VOID: { orderId, kind: 'full', reason } · BELOW_LIST_PRICE: { discountPyg, discountPct?, productId?, description? }
  resolvedValue  Json?     // lo autorizado (puede diferir: pedido 10 → autorizado 7) · DISCOUNT/BELOW_LIST_PRICE: { maxDiscountPyg } · STOCK_ADJUST/ORDER_VOID: { approved: true }
  requestedById  String
  requestedBy    User      @relation("CustomerAuthorizationRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  resolvedById   String?
  resolvedBy     User?     @relation("CustomerAuthorizationResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  note           String?
  resolvedNote   String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  usedAt         DateTime? // DISCOUNT: consumida por una venta autorizada
  usedByOrderId  String?   // DISCOUNT: pedido que la consumió

  @@index([tenantId, status])
  @@index([customerId])
  @@index([usedByOrderId])
  @@index([tenantId, entity, entityId])
}

// Razones sociales/RUC históricos con los que el cliente pidió factura.
model CustomerBillingIdentity {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name        String
  document    String?
  uses        Int       @default(0)
  lastUsedAt  DateTime  @default(now())
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, customerId, document])
  @@unique([customerId, name, document])
  @@index([tenantId, name])
  @@index([customerId])
}

// Nota interna del equipo sobre un cliente (cliente 360°).
model CustomerNote {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  content    String
  createdAt  DateTime @default(now())

  @@index([tenantId, customerId, createdAt])
  @@index([userId])
}

enum FollowUpKind {
  CALL
  WHATSAPP
  VISIT
  OTHER
}

// Seguimiento agendado sobre un cliente (llamada, WhatsApp, visita, otro).
model CustomerFollowUp {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  dueAt      DateTime?
  kind       FollowUpKind @default(OTHER)
  note       String
  doneAt     DateTime?
  createdAt  DateTime     @default(now())

  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, dueAt])
  @@index([userId])
}

// Mensaje de la tienda al cliente (#240 → portal): lo escribe el equipo desde
// la ficha y el cliente lo ve en su cuenta. `firstViewedAt` es el visto/no visto
// que la ficha muestra (se marca al abrir la cuenta, como el informe).
model CustomerNotice {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  content       String
  // Vencimiento opcional: los vencidos dejan de mostrarse en el portal.
  expiresAt     DateTime?
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  createdAt     DateTime  @default(now())

  @@index([tenantId, customerId, createdAt])
  @@index([customerId, firstViewedAt])
  @@index([userId])
}

// Seguimiento del informe de dispositivo compartido (#240 ítem 3): una fila
// por equipo (empresa + serial) con el último envío desde la ficha y las
// aperturas del link público. `channel`/`sharedAt` quedan null cuando el
// cliente lo abrió desde el portal sin un envío previo; `firstViewedAt` es el
// «visto» que muestra la ficha.
model DeviceReportShare {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serial        String
  channel       String?
  sharedAt      DateTime?
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  viewCount     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, serial])
  @@index([customerId, updatedAt])
}

// Regla de comisión por usuario específico o por rol (uno de los dos, nunca
// ambos). El porcentaje se aplica sobre el MARGEN de la venta (total de las
// líneas con costo conocido menos ese costo), nunca sobre el total facturado.
model CommissionRule {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      UserRole?
  percentPyg Decimal? @db.Decimal(5, 2)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, userId])
  @@index([tenantId, role])
}

// Liquidación de comisiones de un vendedor para un período cerrado. El detalle
// por venta queda CONGELADO en `linesJson`: lo que se liquidó y entregó no
// cambia aunque después se editen las reglas, los costos o las ventas. El
// comprobante se verifica sin sesión con su `verificationToken` (QR).
model CommissionSettlement {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerId          String
  seller            User     @relation("CommissionSettlementSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  // Período local de la empresa (YYYY-MM-DD), extremos inclusive.
  periodFrom        String
  periodTo          String
  // Comisión liquidada según el reporte de comisiones del período.
  totalPyg          Int
  // Margen acumulado sobre el que se calculó la comisión.
  marginPyg         Int      @default(0)
  commissionPct     Decimal? @db.Decimal(5, 2)
  // Detalle congelado: [{ orderNumber, date, totalPyg, basePyg, commissionPct, commissionPyg }];
  // la última línea puede ser un "Ajuste por redondeo" cuando la suma por venta
  // no coincide exactamente con el total del reporte.
  linesJson         Json     @default("[]")
  status            String   @default("DRAFT")
  // Token de verificación del comprobante. Desde #172/#178 solo se persiste su
  // sha256 (`verificationTokenHash`); el crudo se revela una vez al emitir. La
  // columna legacy `verificationToken` queda nullable y se vacía en la
  // migración: los QR ya impresos siguen validando por hash.
  verificationToken         String?  @unique
  verificationTokenHash     String?  @unique
  verificationTokenIssuedAt DateTime?
  notes             String?
  createdById       String
  createdBy         User     @relation("CommissionSettlementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  paidAt            DateTime?
  paidById          String?
  paidBy            User?    @relation("CommissionSettlementPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId, sellerId, periodFrom])
  @@index([tenantId, status, createdAt])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String   @default("Principal")
  address    String
  city       String?
  department String?
  country    String   @default("Paraguay")
  notes      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId, isDefault])
}

// Portal público del cliente: enlace/QR por nivel de información
// (rapido | completo) para que vea su saldo, vencimientos, pedidos, garantías
// y direcciones sin sesión. Un token vigente por nivel: regenerarlo lo revoca
// y el enlace anterior deja de funcionar. Nunca expone datos internos.
model CustomerPortalToken {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  level      String    @default("rapido")
  // Solo se guarda el sha256 del token (64 hex); `token` queda para enlaces
  // legacy mientras dure la rotación (nullable: los nuevos no lo usan).
  token      String?   @unique @default(cuid())
  tokenHash  String?   @unique
  createdBy  String?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, level])
  @@index([tenantId, level])
}

// Combo: paquete de productos con precio fijo.
model Combo {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name      String
  pricePyg  Int
  items     Json     @default("[]")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orderItems OrderItem[]

  @@index([tenantId, isActive])
  @@index([branchId])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CONVERTED
  EXPIRED
  CANCELLED
}

// Cotización del pipeline de ventas: puede convertirse en pedido al aceptarse.
model Quote {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName String
  sellerId     String
  seller       User        @relation(fields: [sellerId], references: [id])
  number       String
  items        Json        @default("[]")
  subtotalPyg  Int
  discountPyg  Int         @default(0)
  totalPyg     Int
  notes        String?
  validUntil   DateTime?
  status       QuoteStatus @default(DRAFT)
  // Acceso público del cliente: token no enumerable que viaja en el QR/enlace
  // para aceptar o rechazar la cotización sin sesión.
  publicToken  String?     @unique @default(cuid())
  orderId      String?
  order        Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, validUntil])
  @@index([branchId])
}

model Order {
  tradeInDevices    TradeInDevice[]
  id                String            @id @default(cuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId          String?
  branch            Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerId        String?
  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sellerId          String
  seller            User              @relation(fields: [sellerId], references: [id])
  // Reparto propio: a qué repartidor está asignado el pedido y desde cuándo.
  // Null = sin asignar (el local lo ve y lo puede asignar).
  assignedToId      String?
  assignedTo        User?             @relation("OrderDeliveryAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedAt        DateTime?
  orderNumber       String
  idempotencyKey    String?
  // Token histórico de seguimiento. Ya no se escribe en claro: los enlaces
  // legacy se validan por `publicTokenHash` (sha256) y el enlace vigente del
  // pedido es un token de nivel rápido (`OrderAccessToken`). La columna queda
  // por compatibilidad con los enlaces ya entregados.
  publicToken       String?           @unique
  // Hash del token histórico (sha256 de 64 hex) y cuándo se emitió.
  publicTokenHash   String?           @unique
  publicTokenIssuedAt DateTime?
  status            OrderStatus       @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(PROCESSING)
  subtotalPyg       Int
  discountPyg       Int               @default(0)
  deliveryPyg       Int               @default(0)
  deliveryType      String?
  deliveryNotes     String?
  // Factura a otro titular (esposo/a, padre, empresa): nombre y RUC.
  billingName       String?
  billingDocument   String?
  // Comentario interno de la venta.
  notes             String?
  // Venta a crédito: vencimiento y plazo aplicado (control de mora).
  dueAt             DateTime?
  creditDays        Int?
  // Etiquetas libres del pedido y archivado (oculta del listado activo).
  tags              Json              @default("[]")
  archivedAt        DateTime?
  // Última vez que se avisó al cliente por WhatsApp sobre este pedido.
  notifiedAt        DateTime?
  // Venta cargada sin conexión (POS offline) y sincronizada después: el stock
  // pudo quedar laxo, así que queda marcada para revisión.
  offlineSyncedAt   DateTime?
  totalPyg          Int
  // Comprobante congelado al emitir la venta: lo que se imprimió o mostró no
  // cambia aunque después se edite el producto, el cliente o la empresa.
  // Pedido especial con seña: la venta se toma con anticipo y fecha esperada
  // de llegada/entrega; el saldo se cobra al entregar.
  isSpecialOrder    Boolean           @default(false)
  expectedAt        DateTime?
  receiptSnapshot   Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  items    OrderItem[]
  payments Payment[]
  comments OrderComment[]
  quotes   Quote[]
  accessTokens OrderAccessToken[]
  storeCredits StoreCredit[]
  storeCreditUses StoreCreditUse[]
  loyaltyMovements LoyaltyMovement[]
  sifenDocuments SifenDocument[]

  @@unique([tenantId, orderNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, archivedAt])
  @@index([branchId])
  // Búsqueda difusa por número de pedido (pg_trgm, GIN): ILIKE '%texto%'.
  @@index([orderNumber(ops: raw("gin_trgm_ops"))], map: "Order_orderNumber_trgm_idx", type: Gin)
  @@index([assignedToId])
  @@index([tenantId, assignedToId, fulfillmentStatus])
  supplyNeeds SupplyNeed[]
}

// Acceso público del pedido por nivel de información. Cada token es aleatorio,
// no enumerable y autoriza UNA vista (rapido | completo | detallado); se puede
// revocar y regenerar sin tocar el pedido. El token viejo deja de funcionar.
model OrderAccessToken {
  id        String    @id @default(cuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  level     String    @default("rapido")
  token     String    @unique
  // true = token del QR impreso: el panel no lo lista ni lo revoca al
  // regenerar sus enlaces. Un token impreso sobrevive mientras no se regenere
  // explícitamente con impreso=true.
  impreso   Boolean   @default(false)
  createdBy String?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([orderId, level])
  @@index([tenantId, level])
}

// Comentario interno del pedido, con fotos adjuntas (misma política de
// archivos que los comprobantes de pago).
model OrderComment {
  id        String              @id @default(cuid())
  tenantId  String
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime            @default(now())
  photos    OrderCommentPhoto[]

  @@index([tenantId, orderId, createdAt])
  @@index([tenantId, createdAt])
}

model OrderCommentPhoto {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  commentId  String
  comment    OrderComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  sizeBytes  Int
  sha256     String
  data       Bytes        @db.ByteA
  storageKey String?
  createdAt  DateTime     @default(now())

  @@index([tenantId, commentId])
}

// Comentarios internos de una unidad de inventario (por IMEI/serial) con fotos.
model InventoryUnitComment {
  id        String                    @id @default(cuid())
  tenantId  String
  tenant    Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId    String
  unit      InventoryUnit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime                  @default(now())
  photos    InventoryUnitCommentPhoto[]

  @@index([tenantId, unitId, createdAt])
  @@index([tenantId, createdAt])
}

model InventoryUnitCommentPhoto {
  id         String               @id @default(cuid())
  tenantId   String
  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  commentId  String
  comment    InventoryUnitComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  sizeBytes  Int
  sha256     String
  data       Bytes                @db.ByteA
  storageKey String?
  createdAt  DateTime             @default(now())

  @@index([tenantId, commentId])
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  IN_TRANSIT
  READY_FOR_PICKUP
  PICKED_UP
  PARTIAL
  DELIVERED
  NOT_DELIVERED
}

model MessageTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  name      String
  body      String
  category   String   @default("ORDERS")
  context    String   @default("clientes")
  isDefault  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId, isActive])
  @@index([tenantId, category])
  @@index([tenantId, context])
}

// Campaña de recompra/marketing: agrupa a los clientes contactados en un envío
// con la misma plantilla. El mensaje se congela para auditar qué se dijo.
model MarketingCampaign {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  segment        String
  templateKey    String
  message        String
  // Parámetros del segmento al momento de armar la campaña (días de
  // inactividad, mínimo de compras, categoría), para poder reconstruirla.
  segmentParams  Json?
  recipientCount Int      @default(0)
  skippedCount   Int      @default(0)
  createdById    String?
  createdBy      User?    @relation("MarketingCampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  recipients MarketingRecipient[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([createdById])
}

// Registro por destinatario: a quién se le envió y cuándo, para no repetir.
model MarketingRecipient {
  id         String   @id @default(cuid())
  tenantId   String
  campaignId String
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel    String   @default("WHATSAPP")
  phone      String?
  createdAt  DateTime @default(now())

  @@unique([campaignId, customerId])
  @@index([tenantId, customerId])
  @@index([tenantId, createdAt(sort: Desc)])
}

model OrderItem {
  promotionSnapshot    Json?
  warrantyCases        WarrantyCase[]
  id                   String         @id @default(cuid())
  orderId              String
  order                Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId            String?
  product              Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  description          String
  quantity             Int            @default(1)
  unitPricePyg         Int
  // Precio de lista del producto al momento de la venta (el mayorista si el
  // cliente lo es). La UI y el comprobante muestran el descuento solo cuando
  // la línea se vendió más barato; por encima de lista se muestra normal.
  listPricePyg         Int?
  // Origen congelado del precio resuelto al vender (TIER, LIST, WHOLESALE, RETAIL, USD).
  priceSource          String?
  // Lista del cliente que originó el precio congelado de esta línea.
  priceListId          String?
  unitCostPyg          Int?
  baseUnitCostPyg      Int?
  insurancePyg         Int            @default(0)
  extraCostPyg         Int            @default(0)
  soldWithoutInsurance Boolean        @default(false)
  totalPyg             Int
  // IMEI/seriales físicos vendidos por esta línea. El producto sigue siendo
  // un modelo único; la trazabilidad queda en cada unidad seleccionada.
  serials              Json           @default("[]")
  // Equipos vendidos sobre pedido sin IMEI: se completan al entregar.
  serialsPending       Int            @default(0)
  // La línea se vendió sin costo conocido: falta cargar el costo del producto.
  costPending          Boolean        @default(false)
  // Descuento por línea: fijo en guaraníes o porcentual (uno de los dos).
  discountPyg          Int            @default(0)
  discountPct          Decimal?       @db.Decimal(5, 2)
  // Combo del que salió la línea (trazabilidad comercial): el precio ya viene
  // repartido por componente y el nombre queda congelado por si el combo cambia.
  comboId              String?
  combo                Combo?         @relation(fields: [comboId], references: [id], onDelete: SetNull)
  comboName            String?
  serialsList          OrderItemSerial[]

  @@index([orderId])
  @@index([comboId])
  @@index([productId], map: "OrderItem_productId_idx")
}

// Espejo indexado de OrderItem.serials: permite responder "¿qué venta tiene
// este IMEI/serial?" sin escanear el JSON. Se sincroniza en cada escritura de
// la línea; el JSON sigue siendo el dato que se muestra en el comprobante.
model OrderItemSerial {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  serial      String
  createdAt   DateTime  @default(now())

  @@unique([orderItemId, serial])
  @@index([serial])
  // Búsqueda difusa por serial/IMEI (pg_trgm, GIN): ILIKE '%texto%'.
  @@index([serial(ops: raw("gin_trgm_ops"))], map: "OrderItemSerial_serial_trgm_idx", type: Gin)
}

// Plantilla por categoría: por ejemplo Teléfonos = seguro 2%. Un producto
// puede sobrescribirla, y la venta siempre guarda la foto del costo aplicado.
model CostPolicy {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      String
  insuranceRate Decimal  @default(0) @db.Decimal(5, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, category])
  @@index([tenantId, isActive])
}

model Promotion {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  name      String
  kind      String
  value     Int
  productId String?
  startsAt  DateTime
  endsAt    DateTime
  maxUnits  Int?
  usedUnits Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
}

model Payment {
  accountId       String?
  account         PaymentAccount?  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  accountSnapshot Json?
  currency        PaymentCurrency?
  originalAmount  Decimal?         @db.Decimal(18, 2)
  exchangeRatePyg Decimal?         @db.Decimal(18, 6)
  tradeInDevice   TradeInDevice?
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId         String
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdById     String?
  createdBy       User?            @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  method          PaymentMethod
  status          PaymentStatus    @default(CONFIRMED)
  amountPyg       Int
  reference       String?
  // Quién registró el cobro (la cronología muestra la persona real).
  userId          String?
  idempotencyKey  String?
  paidAt          DateTime         @default(now())
  // Vencimiento de la cuota cuando el pago forma parte de un plan de crédito.
  dueAt           DateTime?
  // Cuándo se envió el recordatorio automático de cuota por vencer.
  remindedAt      DateTime?
  // Cuándo se avisó que la cuota ya venció. Se marca aparte para que el aviso
  // previo al vencimiento no consuma el reclamo posterior.
  overdueRemindedAt DateTime?
  // Recordatorio de cuota por WhatsApp: el enlace wa.me lo abre una persona
  // desde Cobranzas, así que el aviso se marca acá al generarlo. Van separados
  // de los flags del email para no consumir el correo ni al revés: un canal no
  // silencia al otro, y cada uno avisa una sola vez por cuota.
  whatsappRemindedAt DateTime?
  whatsappOverdueRemindedAt DateTime?
  // Fecha estimada de acreditación en la cuenta de la empresa (tarjetas/PIX).
  settlesAt       DateTime?
  // Pre-cobro del reparto propio: quién lo cobró en la calle, cuándo y en qué
  // rendición viajó. El pago nace PENDING y solo pasa a CONFIRMED cuando la
  // tienda verifica la rendición; hasta entonces no cuenta en caja ni cierra
  // el saldo del pedido.
  deliveryUserId  String?
  deliveryUser    User?            @relation("PaymentCollectedBy", fields: [deliveryUserId], references: [id], onDelete: SetNull)
  collectedAt     DateTime?
  deliverySettlementId String?
  deliverySettlement   DeliverySettlement? @relation(fields: [deliverySettlementId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())

  proofs         PaymentProof[]
  reconciliation PaymentReconciliation?
  storeCreditUse StoreCreditUse?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([orderId])
  @@index([deliveryUserId, deliverySettlementId])
  @@index([deliverySettlementId])
}

model PaymentProof {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentId    String
  payment      Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  sizeBytes    Int
  sha256       String
  data         Bytes    @db.ByteA
  storageKey   String?
  uploadedById String
  uploadedBy   User     @relation("PaymentProofUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([tenantId, paymentId, createdAt])
  @@index([uploadedById, createdAt])
}

// Adjunto genérico reutilizable por cualquier módulo. `entity` + `entityId`
// apuntan al documento dueño (gasto, compra, pago a proveedor, sesión de caja o
// traslado) sin acoplarse a su tabla. Los bytes viven en `data` (ByteA) y, si
// hay volumen MOBOS_STORAGE_DIR, además en disco con `storageKey`.
model Attachment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entity      String
  entityId    String
  fileName    String
  mimeType    String
  sizeBytes   Int
  sha256      String
  storageKey  String?
  data        Bytes    @db.ByteA
  createdById String?
  createdBy   User?    @relation("AttachmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([tenantId, entity, entityId])
}

// Tombstone de adjuntos: un archivo eliminado no vuelve solo si un cliente
// externo o un reintento sube los mismos bytes al mismo documento.
model AttachmentTombstone {
  id        String   @id @default(cuid())
  tenantId  String
  entity    String
  entityId  String
  sha256    String
  deletedBy String?
  deletedAt DateTime @default(now())

  @@unique([tenantId, entity, entityId, sha256])
}

model PaymentReconciliation {
  id           String              @id @default(cuid())
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentId    String              @unique
  payment      Payment             @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  state        ReconciliationState @default(PENDING)
  note         String?
  verifiedById String?
  verifiedBy   User?               @relation("PaymentReconciliationVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  // Lote de conciliación que la incluyó (#144). Null = conciliación individual.
  batchId      String?
  batch        ReconciliationBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([tenantId, state])
  @@index([verifiedById, updatedAt])
  @@index([batchId])
}

// Lote de conciliación (#144): un depósito/transferencia recibido que se
// compara contra los pagos que debería cubrir. `expectedPyg` es la suma de los
// pagos incluidos y `receivedPyg` lo informado por el banco/procesadora;
// `differencePyg` = recibido − esperado. Los pagos del lote quedan enlazados
// desde PaymentReconciliation.batchId (trazabilidad pago → lote → cuenta).
model ReconciliationBatch {
  id              String              @id @default(cuid())
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String?
  accountId       String?
  account         PaymentAccount?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  from            DateTime
  to              DateTime
  expectedPyg     Int
  receivedPyg     Int
  differencePyg   Int
  state           ReconciliationState @default(VERIFIED)
  note            String?
  createdById     String?
  createdBy       User?               @relation("ReconciliationBatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  reconciliations PaymentReconciliation[]

  @@index([tenantId, createdAt])
  @@index([accountId, createdAt])
  @@index([tenantId, branchId, createdAt])
}

// Saldo a favor del cliente (nota de crédito interna): nace de una devolución
// sin reembolso en efectivo o de un crédito manual de gerencia. Es una deuda
// de la tienda con el cliente, no un medio de pago externo.
model StoreCredit {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Pedido que lo originó (devolución/cambio); null en un crédito manual.
  orderId      String?
  order        Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  amountPyg    Int
  remainingPyg Int
  note         String?
  createdById  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  uses         StoreCreditUse[]

  @@index([tenantId, customerId])
  @@index([tenantId, remainingPyg])
}

// Consumo del saldo a favor: cada uso queda atado al pedido y al cobro que lo
// aplicó, para que el estado de cuenta del cliente sea reconstruible.
model StoreCreditUse {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creditId    String
  credit      StoreCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId   String?     @unique
  payment     Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  amountPyg   Int
  createdById String?
  createdAt   DateTime    @default(now())

  @@index([tenantId, orderId])
}

// Fidelización: puntos por venta medidos en guaraníes (1 punto = 1 Gs. de
// valor canjeable). El saldo vigente es Customer.loyaltyPointsPyg; estos
// movimientos lo explican (devengo por venta, canje como saldo a favor o
// ajuste manual).
enum LoyaltyMovementKind {
  ACCRUAL
  REDEMPTION
  ADJUSTMENT
}

model LoyaltyMovement {
  id          String              @id @default(cuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  kind        LoyaltyMovementKind
  // Positivo acredita, negativo descuenta. 1 punto = 1 Gs.
  pointsPyg   Int
  note        String?
  createdById String?
  createdAt   DateTime            @default(now())

  @@index([tenantId, customerId, createdAt])
}

// Rendición del reparto: el repartidor entrega en la tienda lo que cobró en la
// calle (efectivo o transferencia) y declara el saldo que quedó pendiente. El
// vendedor o la caja la verifica y recién ahí los pre-cobros pasan a CONFIRMED
// y se reflejan en el pedido y en caja/finanzas.
model DeliverySettlement {
  id               String                   @id @default(cuid())
  tenantId         String
  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId         String?
  branch           Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  deliveryUserId   String
  deliveryUser     User                     @relation("DeliverySettlementRenderedBy", fields: [deliveryUserId], references: [id], onDelete: Restrict)
  // Lo que el repartidor entrega (suma de los pre-cobros rendidos) y el saldo
  // que queda vivo en esos pedidos después de esta rendición.
  totalPyg         Int
  pendingPyg       Int                      @default(0)
  ordersCount      Int                      @default(0)
  note             String?
  status           DeliverySettlementStatus @default(PENDING)
  verifiedById     String?
  verifiedBy       User?                    @relation("DeliverySettlementVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt       DateTime?
  verificationNote String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  payments Payment[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, deliveryUserId, createdAt])
}

enum DeliverySettlementStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  CREDIT
  TRADE_IN
  PIX
  CRYPTO
  STORE_CREDIT
}

enum PaymentCurrency {
  PYG
  USD
  BRL
  EUR
  USDT
}

enum PaymentAccountKind {
  CASH
  TRANSFER
  CARD
  TRADE_IN
  PIX
  CRYPTO
}

enum CustomerPricing {
  RETAIL
  WHOLESALE
}

enum PriceListCurrency {
  PYG
  USD
}

enum PriceListScope {
  PRODUCT
  CATEGORY
}

// Lista de precios por cliente: condiciones negociadas por producto o
// categoría, con escalones por cantidad. Reemplaza al precio mayorista fijo
// cuando el ítem aplicable existe; si no, la resolución cae al precio del
// cliente (mayorista o minorista).
model PriceList {
  id        String            @id @default(cuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  // Deprecada: no interviene en la resolución (el precio de cada ítem define su
  // moneda con `unitPriceUsd`). Se mantiene por compatibilidad de respuestas.
  currency  PriceListCurrency @default(PYG)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  items     PriceListItem[]
  customers Customer[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

// Ítem de una lista: alcanza a un producto exacto o a toda una categoría
// (exactamente uno según `scope`) y define el precio por monto fijo en PYG,
// monto en USD o descuento porcentual sobre pricePyg.
model PriceListItem {
  id           String          @id @default(cuid())
  priceListId  String
  priceList    PriceList       @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  scope        PriceListScope
  productId    String?
  product      Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  category     String?
  unitPricePyg Int?
  unitPriceUsd Decimal?        @db.Decimal(14, 2)
  discountPct  Decimal?        @db.Decimal(5, 2)

  tiers        PriceTier[]

  @@index([priceListId])
  @@index([productId])
}

// Escalón por cantidad de un ítem: desde `minQty` unidades rige `unitPricePyg`.
// Gana el escalón con el mayor minQty que no supere la cantidad vendida.
model PriceTier {
  id              String        @id @default(cuid())
  priceListItemId String
  priceListItem   PriceListItem @relation(fields: [priceListItemId], references: [id], onDelete: Cascade)
  minQty          Int
  unitPricePyg    Int

  @@unique([priceListItemId, minQty])
}

enum ProductDestination {
  NORMAL
  OFFER
  WHOLESALE
}

enum TradeInStatus {
  RECEIVED
  REVIEW
  REPAIR
  READY
  STOCK
  SOLD_EXTERNAL
}

model PaymentAccount {
  id            String             @id @default(cuid())
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  bank          String?
  holder        String?
  accountNumber String?
  // Datos del titular y del medio (#142): cédula/RUC del titular, procesadora
  // o adquirente de tarjeta, llave Pix, referencia libre (USDT/canje) y
  // etiqueta de la moneda cuando es personalizada.
  document      String?
  processor     String?
  pixKey        String?
  reference     String?
  currencyLabel String?
  // Titular registrado (#143) y empresa/persona jurídica dueña de la cuenta.
  // `holder` sigue guardando el nombre compuesto para historial y búsquedas.
  holderId      String?
  holderProfile AccountHolder?     @relation(fields: [holderId], references: [id], onDelete: SetNull)
  companyId     String?
  company       PrivateCompany?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  currency      PaymentCurrency
  kind          PaymentAccountKind
  isActive      Boolean            @default(true)
  feePercent    Decimal            @default(0) @db.Decimal(5, 2)
  // Descuento sugerido al cobrar con este medio (0–100, hasta 2 decimales).
  discountPct   Decimal            @default(0) @db.Decimal(5, 2)
  // Días que tarda el medio en acreditar (ej. tarjeta: 1-3); 0 = inmediato.
  settlementDays Int               @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  payments      Payment[]
  cashMovements CashMovement[]
  purchasePayments PurchasePayment[]
  reconciliationBatches ReconciliationBatch[]

  @@index([tenantId, isActive])
  @@index([holderId])
  @@index([companyId])
}

// Empresa o persona jurídica con datos privados (#143): nombre legal, RUC y
// dirección legal. Vive separada del nombre fantasía, la dirección comercial y
// la información pública de la tienda; se usa como titular de cuentas.
model PrivateCompany {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalName    String
  ruc          String?
  legalAddress String?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  paymentAccounts PaymentAccount[]

  @@index([tenantId, isActive])
}

// Socio/titular de una cuenta de cobro (#143): nombres en orden (1º, 2º y 3º),
// apellidos (1º y 2º) y cédula/RUC. Se ofrece en transferencia, Pix y USDT.
model AccountHolder {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName      String
  middleName     String?
  otherName      String?
  lastName       String
  secondLastName String?
  document       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  paymentAccounts PaymentAccount[]

  @@index([tenantId, isActive])
}

model TradeInDevice {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId      String        @unique
  payment        Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  serial         String
  model          String
  conditionNotes String
  valuePyg       Int
  status         TradeInStatus @default(RECEIVED)
  repairCostPyg  Int           @default(0)
  diagnosis      String?
  technicianName String?
  accessories    Json          @default("[]")
  photos         Json          @default("[]")
  notes          String?
  productId      String?       @unique
  product        Product?      @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([tenantId, serial])
  @@index([tenantId, branchId, status])
  @@index([orderId])
}

// Valor sugerido de toma por modelo, capacidad y condición. El POS lo muestra
// al cargar un equipo como parte de pago: es una sugerencia editable, nunca un
// tope. `modelKey` es la clave de comparación sin mayúsculas ni acentos y
// `storage` vacío evita el NULL que rompería el índice único.
model DeviceValuation {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  model        String
  modelKey     String
  storage      String           @default("")
  condition    ProductCondition @default(USED)
  baseValuePyg Int
  maxValuePyg  Int?
  notes        String?
  isActive     Boolean          @default(true)
  createdById  String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([tenantId, modelKey, storage, condition])
  @@index([tenantId, isActive])
  @@index([tenantId, condition, isActive])
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
  REFUNDED
}

enum ReconciliationState {
  PENDING
  VERIFIED
  REJECTED
}

// Venta suspendida (carrito en espera): guarda el borrador del POS para
// retomarlo desde cualquier caja autorizada de la sucursal. No toca stock,
// caja ni deuda hasta que se recupera y se cobra.
model SuspendedSale {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  label       String?
  // Estado del carrito tal como lo serializa el POS (items, cliente, descuento,
  // entrega y facturación). El backend no lo interpreta.
  payload     Json
  // Enlace público del borrador (sin autenticación): solo se guarda el sha256
  // del token de 64 hex (docs/TOKENS.md). Se regenera para invalidar el anterior.
  publicTokenHash   String?   @unique
  publicTokenIssuedAt DateTime?
  // Vencimiento del enlace público: se emite y se valida con el reloj de
  // Postgres (docs/TOKENS.md). Null = enlaces emitidos antes de esta regla.
  publicTokenExpiresAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
  // Texto denormalizado (acción + entidad + id + metadato) que mantiene un
  // trigger en la base: la búsqueda de la auditoría alcanza el detalle sin
  // recorrer el JSONB fila por fila.
  searchText String  @default("")
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  // Índice del JSONB para la búsqueda por metadato (migración
  // 20261023000000_print_branch_bridges). La migración lo creó y el schema no
  // lo declaraba: `npm run db:check` lo marcaba como sobrante.
  @@index([metadata(ops: JsonbPathOps)], type: Gin)
}

model CashSession {
  id          String    @id
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  openedById  String
  openedBy    User      @relation("CashOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedById  String?
  closedBy    User?     @relation("CashClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  openingPyg  Int
  countedPyg  Int?
  expectedPyg Int?
  // Arqueo por denominación del turno: {"100000": 3, "50000": 1, ...}. El total
  // contado se deriva de acá cuando está presente.
  countedBreakdown Json?
  status      String    @default("OPEN")
  notes       String?

  // Un turno abierto por persona y sucursal: índice parcial definido en SQL.
  @@index([tenantId, branchId, openedAt])
}

// Libro de movimientos no ligados a una venta: gastos, cheques, adelantos y
// transferencias. Cada registro conserva la moneda/cotización de su fecha.
model CashMovement {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  accountId       String?
  account         PaymentAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdById     String
  kind            CashMovementKind
  direction       CashDirection
  currency        PaymentCurrency @default(PYG)
  originalAmount  Decimal         @db.Decimal(18, 2)
  exchangeRatePyg Decimal         @default(1) @db.Decimal(18, 6)
  amountPyg       Int
  counterparty    String?
  reference       String?
  description     String
  status          CashMovementStatus @default(PENDING)
  dueAt           DateTime?
  clearedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, status, dueAt])
  @@index([accountId, createdAt])
}

enum CashMovementKind {
  EXPENSE
  TRANSFER
  SUPPLIER_ADVANCE
  CHEQUE
  OWNER_WITHDRAWAL
  ADJUSTMENT
}

enum CashDirection {
  IN
  OUT
}

enum CashMovementStatus {
  PENDING
  CLEARED
  VOID
}

enum PurchaseStatus {
  DRAFT
  PARTIAL
  RECEIVED
}

model PurchaseOrder {
  id           String         @id
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplierName String
  // El nombre se conserva como snapshot del documento, aun si luego cambia la ficha.
  supplierId   String?
  supplier     Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  status       PurchaseStatus @default(DRAFT)
  createdAt    DateTime       @default(now())
  receivedAt   DateTime?
  createdById  String
  createdBy    User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  shippingPyg  Int            @default(0)
  customsPyg   Int            @default(0)
  insurancePyg Int            @default(0)
  taxesPyg     Int            @default(0)
  otherCostsPyg Int           @default(0)
  currency     PaymentCurrency @default(PYG)
  exchangeRatePyg Decimal     @default(1) @db.Decimal(18, 6)
  originalSubtotal Decimal?   @db.Decimal(18, 2)
  dueAt        DateTime?
  supplierReference String?
  creditEnabled Boolean        @default(false)
  costAllocationMethod PurchaseCostAllocationMethod @default(PROPORTIONAL_VALUE)
  lines        PurchaseLine[]
  payments     PurchasePayment[]
  returns      PurchaseReturn[]

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, supplierId, createdAt])
}

// #250 Fase 1 (Centro de Abastecimiento): necesidad de abastecimiento — la
// demanda que alimenta el panel «Por comprar». Se genera desde una venta o una
// reserva sin stock, por bajo punto de reposición, o se carga a mano; la
// compra/recepción (Fases 2-5) la resuelven. **No crea stock**: solo tras la
// recepción la unidad queda disponible.
model SupplyNeed {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Destino final de las unidades (la sucursal que las necesita).
  branchId     String?
  branch       Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  productId    String
  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Variante exacta a comprar: nunca se mezclan condición/capacidad/color en la
  // consolidación (#250 §5).
  condition    ProductCondition @default(NEW)
  quantity     Int
  // SALE_NO_STOCK · RESERVATION_NO_STOCK · QUANTITY_OVER_STOCK · BELOW_REORDER ·
  // ORDER_COMMITTED · MANUAL (ver backend/lib/supply.ts).
  source       String
  priority     String           @default("NORMAL")
  status       String           @default("OPEN")
  // Fecha prometida al cliente (prioriza la compra) y vínculo con el pedido.
  promisedAt   DateTime?
  orderId      String?
  order        Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItemId  String?
  customerId   String?
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?            @relation("SupplyNeedAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes        String?
  // Compra que la cubrió (Fase 2): el panel muestra con qué compra se resolvió.
  purchaseId   String?
  purchase     SupplyPurchase?  @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User             @relation("SupplyNeedAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  // Clave de deduplicación de las automáticas: repetir la misma demanda no crea
  // otra fila (las manuales van sin clave y conviven).
  dedupeKey    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, priority, createdAt])
  @@index([tenantId, productId, condition, status])
  @@index([tenantId, branchId, status])
  @@index([tenantId, purchaseId])
  purchaseLines SupplyPurchaseLine[]
}

// #250 Fase 2 (Centro de Abastecimiento): compra rápida y stock adicional. La
// compra registra lo que se compró (proveedor, costo/moneda, factura,
// referencia, IMEIs ahora o pendientes) y cubre necesidades del panel; **no
// mueve stock**: las unidades aparecen recién en la recepción (F5).
model SupplyPurchase {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Identificador compartido (#250 §2): panel, ticket, etiqueta y recepción.
  code            String
  branchId        String?
  branch          Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplierId      String?
  supplier        Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  // Snapshot del proveedor (igual que Compras): el documento no cambia si luego
  // se edita la ficha.
  supplierName    String
  currency        PaymentCurrency @default(PYG)
  originalCost    Decimal?        @db.Decimal(14, 2)
  exchangeRatePyg Decimal?        @db.Decimal(14, 4)
  costPyg         Int?
  reference       String?
  notes           String?
  status          String          @default("COMPRADA")
  createdById     String
  createdBy       User            @relation("SupplyPurchaseAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lines           SupplyPurchaseLine[]
  needs           SupplyNeed[]

  @@unique([tenantId, code])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, supplierId, createdAt])
  shipments SupplyShipment[]
}

model SupplyPurchaseLine {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseId  String
  purchase    SupplyPurchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  // Necesidad que cubre esta línea (null en la compra adicional / reposición libre).
  needId      String?
  need        SupplyNeed?      @relation(fields: [needId], references: [id], onDelete: SetNull)
  productId   String
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  condition   ProductCondition @default(NEW)
  quantity    Int
  unitCostPyg Int?
  createdAt   DateTime         @default(now())
  serials     SupplyPurchaseSerial[]

  @@index([tenantId, purchaseId])
  @@index([tenantId, needId])
  shipmentItems SupplyShipmentItem[]
}

model SupplyPurchaseSerial {
  id        String             @id @default(cuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lineId    String
  line      SupplyPurchaseLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  // IMEI/serial cargado en la compra (Luhn y sin duplicados por empresa); las
  // líneas pueden quedar sin seriales y completarse antes de despachar (F3).
  serial    String
  createdAt DateTime           @default(now())

  @@unique([tenantId, serial])
  @@index([tenantId, lineId])
}

// #250 Fase 4 (Centro de Abastecimiento): envíos entrantes (lotes) de una
// compra. Una compra puede viajar en varios lotes con métodos distintos
// (bus/transportadora/AEX/importación). El lote es un **envío entrante
// externo**, nunca un traslado interno; la recepción (F5) es la que crea stock.
model SupplyShipment {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Identificador compartido (#250 §2): ENV-CDE-ASU-0021.
  code            String
  purchaseId      String
  purchase        SupplyPurchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  origin          String
  destinationBranchId String?
  destinationBranch Branch?       @relation("SupplyShipmentDestination", fields: [destinationBranchId], references: [id], onDelete: SetNull)
  // BUS · TRANSPORTADORA · AEX · IMPORTACION (ver backend/lib/supply.ts).
  method          String
  company         String?
  driver          String?
  guide           String?
  responsibleId   String?
  responsible     User?           @relation("SupplyShipmentResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  status          String          @default("BORRADOR")
  etaAt           DateTime?
  sentAt          DateTime?
  arrivedAt       DateTime?
  notes           String?
  // Acceso público del manifiesto: token no enumerable que viaja en el QR.
  publicToken     String?         @unique @default(cuid())
  createdById     String
  createdBy       User            @relation("SupplyShipmentAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  items           SupplyShipmentItem[]

  @@unique([tenantId, code])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, purchaseId])
}

model SupplyShipmentItem {
  id         String         @id @default(cuid())
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipmentId String
  shipment   SupplyShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  lineId     String
  line       SupplyPurchaseLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  productId  String
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  // IMEI conocido al despachar; null = todavía pendiente (se completa antes o en
  // la recepción, F5).
  serial     String?
  status     String         @default("EN_LOTE")
  createdAt  DateTime       @default(now())

  @@unique([tenantId, serial])
  @@index([tenantId, shipmentId])
  @@index([tenantId, lineId])
}

model Supplier {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  // Abreviatura visible para vendedores en stock; el nombre real solo lo ve administración.
  code         String?
  document     String?
  phone        String?
  address      String?
  city         String?
  department   String?
  email        String?
  // Persona de contacto de la ficha del proveedor.
  contactName  String?
  // Términos de pago libres, por ejemplo 'CONTADO' o '7 días'.
  paymentTerms String?
  notes        String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  purchases    PurchaseOrder[]
  inventoryUnits InventoryUnit[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId, isActive, name])
  supplyPurchases SupplyPurchase[]
}

enum PurchaseCostAllocationMethod {
  PROPORTIONAL_VALUE
  PROPORTIONAL_QUANTITY
}

model PurchaseLine {
  id          String        @id
  purchaseId  String
  purchase    PurchaseOrder @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Int
  // Unidades ya recibidas: permite recepción parcial contra la misma orden.
  receivedQty Int @default(0)
  // unitCostPyg es el costo base pactado; los valores finales quedan congelados
  // para que una modificación posterior de flete o de catálogo no reescriba historia.
  unitCostPyg Int
  lotReference String?
  baseTotalPyg Int @default(0)
  allocatedShippingPyg Int @default(0)
  allocatedCustomsPyg Int @default(0)
  allocatedInsurancePyg Int @default(0)
  allocatedTaxesPyg Int @default(0)
  allocatedOtherCostsPyg Int @default(0)
  allocatedExtraCostPyg Int @default(0)
  finalTotalCostPyg Int @default(0)
  finalUnitCostPyg Int @default(0)

  @@index([purchaseId])
  @@index([productId])
}

// Devolución al proveedor: sale stock y baja la deuda de esa compra. Cada
// línea conserva el costo final congelado con el que salió del inventario.
model PurchaseReturn {
  id          String               @id @default(cuid())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseId  String
  purchase    PurchaseOrder        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  supplierId  String?
  reason      String
  totalPyg    Int
  createdById String
  createdAt   DateTime             @default(now())
  lines       PurchaseReturnLine[]

  @@index([tenantId, purchaseId])
  @@index([tenantId, supplierId])
}

model PurchaseReturnLine {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  returnId     String
  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  purchaseLineId String
  productId    String
  product      Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity     Int
  unitCostPyg  Int
  totalPyg     Int

  @@index([returnId])
  @@index([productId])
}

model PurchasePayment {
  id              String          @id @default(cuid())
  tenantId        String
  purchaseId      String
  purchase        PurchaseOrder   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  accountId       String?
  account         PaymentAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  amountPyg       Int
  currency        PaymentCurrency @default(PYG)
  originalAmount  Decimal         @db.Decimal(18, 2)
  exchangeRatePyg Decimal         @default(1) @db.Decimal(18, 6)
  reference       String?
  kind            PurchasePaymentKind @default(SETTLEMENT)
  paidAt          DateTime        @default(now())
  createdById     String
  createdAt       DateTime        @default(now())

  @@index([tenantId, purchaseId, paidAt])
}

enum PurchasePaymentKind {
  ADVANCE
  SETTLEMENT
}

enum WarrantyKind {
  SERVICE
  COVERAGE
}

enum WarrantyStatus {
  RECEIVED
  DIAGNOSIS
  READY
  DELIVERED
}

model WarrantyCase {
  id              String         @id
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  orderItemId     String?
  orderItem       OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        Customer?      @relation("WarrantyCaseCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  customerName    String
  serial          String
  description     String
  kind            WarrantyKind   @default(SERVICE)
  status          WarrantyStatus @default(RECEIVED)
  responsibleName String?
  diagnosis       String?
  technicianName  String?
  parts           Json           @default("[]")
  photos          Json           @default("[]")
  resolution      String?
  repairCostPyg   Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
  expiresAt       DateTime?
  // Página pública de garantía: el cliente ve modelo, días restantes y
  // cobertura con solo escanear el QR del comprobante.
  // `publicToken` queda solo para enlaces legacy (rotación pendiente); los
  // nuevos guardan únicamente `publicTokenHash` (sha256 del token de 64 hex).
  publicToken     String?        @unique
  publicTokenHash String?        @unique
  warrantyDays    Int?
  coverage        String?
  exclusions      String?

  warrantyPhotos  WarrantyPhoto[]
  // Órdenes de servicio originadas en este caso (#224).
  serviceOrders   ServiceOrder[] @relation("ServiceOrderWarranty")

  @@index([tenantId, createdAt])
  @@index([tenantId, serial])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@index([tenantId, kind])
  @@index([customerId])
}

// Foto de un caso de garantía: guardada en la base con el mismo criterio que
// los comprobantes de pago (tipo permitido, magic bytes, tamaño y sha256).
model WarrantyPhoto {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warrantyCaseId String
  warrantyCase   WarrantyCase @relation(fields: [warrantyCaseId], references: [id], onDelete: Cascade)
  label          String?
  fileName       String
  mimeType       String
  sizeBytes      Int
  sha256         String
  data           Bytes        @db.ByteA
  storageKey     String?
  createdAt      DateTime     @default(now())

  @@index([tenantId, warrantyCaseId, createdAt])
}

// Orden de servicio técnico: recepción → diagnóstico → reparación → entrega,
// con costos y rentabilidad. Los ids de sucursal/cliente/técnico se guardan
// como texto para no acoplar el ciclo del taller a otras tablas.
model ServiceOrder {
  id             String    @id @default(cuid())
  tenantId       String
  branchId       String?
  customerId     String?
  customer       Customer?      @relation("ServiceOrderCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  customerName   String
  device         String
  serial         String?
  serviceName    String?
  // Número comercial de la orden (`OS-#0001`) derivado del máximo de la tienda.
  serviceNumber  String?
  reportedIssue  String?
  diagnosis      String?
  checklist      Json      @default("{}")
  technicianId   String?
  technicianName String?
  status         String    @default("RECIBIDO")
  // Garantía que originó esta orden (#224): la conversión conserva el historial.
  warrantyCaseId String?
  warrantyCase   WarrantyCase? @relation("ServiceOrderWarranty", fields: [warrantyCaseId], references: [id], onDelete: SetNull)
  pricePyg       Int       @default(0)
  // Costo total del trabajo. Si la orden tiene el desglose cargado
  // (repuesto + mano de obra + otros), el total se calcula y se guarda acá.
  costPyg        Int       @default(0)
  partsPyg       Int?
  laborPyg       Int?
  otherCostPyg   Int?
  // Código de desbloqueo (PIN y/o patrón) cifrado, atado a esta orden.
  unlockSecret   String?
  unlockUpdatedAt DateTime?
  notes          String?
  receivedAt     DateTime  @default(now())
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, serviceNumber])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([customerId])
  @@index([warrantyCaseId])
}

// Catálogo de servicios técnicos: nombre, tipo de dispositivo y precio sugerido.
// El precio de la orden se puede sobrescribir a mano.
model ServiceItem {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  deviceType        String   @default("iPhone")
  suggestedPricePyg Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

// Puntos del checklist de recepción configurables por tipo de dispositivo.
// La orden guarda el checklist marcado en `ServiceOrder.checklist` (Json con
// estas etiquetas como claves); esta tabla define qué se ofrece al recibir.
model ServiceChecklistItem {
  id         String   @id @default(cuid())
  tenantId   String
  deviceType String   @default("iPhone")
  label      String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, deviceType, label])
  @@index([tenantId, deviceType, isActive])
}

// Solicitud de cambio comercial del cliente (pasar a mayorista o habilitar
// crédito): la pide cualquier usuario y la resuelve administración/gerencia.

// Titulares de factura que el cliente ya usó: se proponen en la próxima venta
// y la búsqueda puede encontrar al cliente por esa razón social.


// Logo de la empresa para comprobantes y documentos. Los bytes viven en el
// volumen de adjuntos (MOBOS_STORAGE_DIR) con respaldo en `data`.
model TenantLogo {
  id         String   @id @default(cuid())
  tenantId   String
  // 'light' = logo para modo claro (oscuro); 'dark' = para modo oscuro (claro).
  variant    String   @default("light")
  storageKey String?
  data       Bytes?   @db.ByteA
  mimeType   String
  sha256     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, variant])
}

// Foto de perfil del usuario para las cronologías y el equipo. Los bytes viven
// en el volumen de adjuntos con respaldo en `data`.
model UserAvatar {
  id         String   @id @default(cuid())
  userId     String   @unique
  storageKey String?
  data       Bytes?   @db.ByteA
  mimeType   String
  sha256     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Presencia en vivo: una fila por pestaña abierta. "En línea" = latido en los
// últimos 75 s (2,5x el pulso de 30 s). El alcance es la sección que se mira.
model PresenceTab {
  tenantId   String
  userId     String
  tabId      String   @db.Uuid
  scope      String?
  lastSeenAt DateTime @default(now())
  isActive   Boolean  @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId, tabId])
  @@index([tenantId, lastSeenAt(sort: Desc)])
}

// Consumo por pestaña de trabajo para el panel de uso del equipo (30 días).
model UsageSession {
  tenantId      String
  userId        String
  sessionKey    String
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  activeSeconds Int      @default(0)
  wasActive     Boolean  @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId, sessionKey])
  @@index([tenantId, lastSeenAt(sort: Desc)])
}

// Puente de impresión: una computadora con el agente instalado. El token del
// agente se guarda hasheado; el código de vinculación es de un solo uso.
model PrintBridge {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  // Hash SHA-256 del token. Hasta que se canjea el código apunta a un token
  // descartable: el puente no puede autenticarse sin parear.
  tokenHash        String    @unique
  pairingCodeHash  String?
  pairingExpiresAt DateTime?
  pairingUsedAt    DateTime?
  pairingAttempts  Int       @default(0)
  createdByUserId  String?
  createdBy        User?     @relation("PrintBridgeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  // Sucursal que sirve este puente (null = puente de empresa, fallback).
  branchId         String?
  branch           Branch?   @relation("PrintBridgeBranch", fields: [branchId], references: [id], onDelete: SetNull)
  version          String?
  platform         String?
  lastSeenAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  printers PrintPrinter[]
  jobs     PrintJob[]

  @@index([tenantId, revokedAt])
  @@index([pairingCodeHash])
  @@index([tenantId, branchId])
}

// Impresora configurada por empresa. `destination` usa el formato del agente:
// `lan:host:puerto`, `cups:<cola>` (o el legacy `usb:<cola>`).
model PrintPrinter {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Sucursal que sirve esta impresora (null = empresa, fallback).
  branchId    String?
  branch      Branch?  @relation("PrintPrinterBranch", fields: [branchId], references: [id], onDelete: SetNull)
  bridgeId    String?
  bridge      PrintBridge? @relation(fields: [bridgeId], references: [id], onDelete: SetNull)
  name        String
  brand       String       @default("")
  model       String       @default("")
  location    String       @default("")
  connection  String       @default("lan")
  destination String
  width       Int          @default(80)
  copies      Int          @default(1)
  cut         Boolean      @default(true)
  density     Int          @default(3)
  characters  Boolean      @default(true)
  isDefault   Boolean      @default(false)
  isActive    Boolean      @default(true)
  lastTest    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  jobs PrintJob[]

  @@unique([tenantId, destination])
  @@index([tenantId, isActive])
  @@index([tenantId, branchId])
}

// Trabajo de impresión. El payload ESC/POS es transitorio: se borra al
// reportar un resultado terminal. El sufijo de confirmación se guarda hasheado.
model PrintJob {
  id                String        @id @default(cuid())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bridgeId          String?
  bridge            PrintBridge?  @relation(fields: [bridgeId], references: [id], onDelete: SetNull)
  printerId         String?
  printer           PrintPrinter? @relation(fields: [printerId], references: [id], onDelete: SetNull)
  destination       String
  kind              String
  state             PrintJobState @default(PENDIENTE)
  path              PrintJobPath  @default(REMOTO)
  payload           String?       @db.Text
  payloadBytes      Int           @default(0)
  validation        String        @default("")
  suffixHash        String        @default("")
  // Largo del sufijo impreso (1..8). El valor NUNCA se guarda: solo el hash.
  // El panel lo usa para validar automáticamente al completar el código (#138).
  // 0 = desconocido (trabajos anteriores a la columna).
  suffixLength      Int           @default(0)
  reference         String        @default("")
  requestedByUserId String?
  requestedBy       User?         @relation("PrintJobRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  requestedByName   String        @default("")
  deviceName        String        @default("")
  bridgeName        String        @default("")
  tokenHint         String        @default("")
  mode              String        @default("")
  width             Int           @default(80)
  // Telemetría del trabajo: tiempos reales hasta imprimir (issue de comparativa).
  printerName       String?
  enqueuedAt        DateTime      @default(now())
  queueMs           Int?
  durationMs        Int?
  transport         String?
  copies            Int           @default(1)
  attempts          Int           @default(0)
  leaseId           String?
  leaseExpiresAt    DateTime?
  claimedAt         DateTime?
  acceptedAt        DateTime?
  confirmedAt       DateTime?
  error             String?
  idempotencyKey    String?
  sourceJobId       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, sourceJobId])
  @@index([tenantId, state, createdAt])
  @@index([bridgeId, state])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, enqueuedAt(sort: Desc)])
}

enum PrintJobState {
  PENDIENTE
  RECLAMADO
  ACEPTADO
  INCIERTO
  FALLIDO
  CONFIRMADO
  CANCELADO
}

enum PrintJobPath {
  LOCAL
  REMOTO
}

// Documento electrónico de SIFEN (#130, Fase 1). Guarda el XML, el CDC y el
// estado por pedido. Sin certificado configurado la app sigue emitiendo
// documentos no fiscales y esta tabla queda vacía: la emisión real es Fase 2.
model SifenDocument {
  id                String              @id @default(cuid())
  tenantId          String
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId           String
  order             Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status            SifenDocumentStatus @default(DRAFT)
  // Ambiente de SIFEN con el que se emitió (test | prod).
  ambiente          String              @default("test")
  tipoDocumento     Int                 @default(1)
  establecimiento   String
  puntoExpedicion   String
  numero            Int
  timbrado          String
  // CDC de 44 dígitos; null mientras el borrador no se compone.
  cdc               String?
  // XML del DE (borrador sin firma hasta la Fase 2).
  xml               String?
  // Respuesta normalizada de SIFEN (código, mensaje y protocolo).
  respuesta         Json?
  // Último error de envío/consulta, en texto plano.
  error             String?
  enviadoAt         DateTime?
  resueltoAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Un DE por pedido y ambiente: reintentos y correcciones reutilizan la fila.
  @@unique([orderId, ambiente])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([cdc])
}

enum SifenDocumentStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}

// Auditoría de efectivo (#161): marca por operación de caja (cobro o
// movimiento) con estado verificada/pendiente/con diferencia, observación y
// usuario real que auditó. La operación vive en Payment o CashMovement.
model CashAuditMark {
  id            String          @id @default(cuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operationKind String
  operationId   String
  status        CashAuditStatus @default(PENDING)
  note          String?
  auditedById   String?
  auditedBy     User?           @relation("CashAuditAuditedBy", fields: [auditedById], references: [id], onDelete: SetNull)
  auditedAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([tenantId, operationKind, operationId])
  @@index([tenantId, status])
}

enum CashAuditStatus {
  VERIFIED
  PENDING
  DIFFERENCE
}

// Registro de cada consulta de IMEI (#193): proveedor, servicio, estado, costo
// real, fecha, id externo, respuesta original (protegida) y campos normalizados.
model ImeiCheckQuery {
  id          String    @id @default(cuid())
  tenantId    String
  branchId    String?
  userId      String?
  imei        String
  imeiMasked  String
  provider    String    @default("imeicheck.net")
  serviceKey  String
  serviceId   String?
  serviceName String
  status      String
  costUsd     Decimal   @default(0) @db.Decimal(10, 2)
  externalId  String?
  responseRaw Json?
  normalized  Json      @default("[]")
  requestId   String?   @unique
  error       String?
  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([tenantId, imei, requestedAt])
  @@index([tenantId, requestedAt])
  conciliatedAt     DateTime?
  conciliationNote  String?
}
