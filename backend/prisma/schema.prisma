generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  googleIdentity      GoogleIdentity?
  promotions          Promotion[]
  paymentAccounts     PaymentAccount[]
  tradeInDevices      TradeInDevice[]
  cashSessions        CashSession[]
  purchases           PurchaseOrder[]
  warrantyCases       WarrantyCase[]
  cashMovements       CashMovement[]
  id                  String           @id @default(cuid())
  name                String
  email               String?          @unique
  passwordHash        String?
  failedLoginAttempts Int              @default(0)
  lockedUntil         DateTime?
  archivedAt          DateTime?
  archivedReason      String?
  slug                String           @unique
  settings            Json             @default("{}")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  branches                Branch[]
  users                   User[]
  sessions                Session[]
  products                Product[]
  customers               Customer[]
  orders                  Order[]
  payments                Payment[]
  paymentProofs           PaymentProof[]
  paymentReconciliations  PaymentReconciliation[]
  auditLogs               AuditLog[]
  inventoryUnits          InventoryUnit[]
  stockTransfers          StockTransfer[]
  costPolicies            CostPolicy[]
  stockVisibilityGranted  InventoryVisibilityGrant[] @relation("StockVisibilityProvider")
  stockVisibilityReceived InventoryVisibilityGrant[] @relation("StockVisibilityRecipient")
  stockLocations          StockLocation[]
  messageTemplates        MessageTemplate[]
  passwordResetTokens     PasswordResetToken[]
  authAttempts            AuthAttempt[]
}

model GoogleIdentity {
  subject  String @id
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Tokens de recuperación de contraseña de la empresa. Solo se almacena su
// hash y cada uso invalida todos los tokens anteriores de la misma empresa.
model PasswordResetToken {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([tenantId, expiresAt])
}

// Ventana persistente de intentos sensibles por origen pseudonimizado. No se
// conserva una IP ni un correo en claro: el fingerprint se deriva en servidor.
model AuthAttempt {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scope       String
  fingerprint String
  createdAt   DateTime @default(now())

  @@index([scope, fingerprint, createdAt])
  @@index([tenantId, createdAt])
}

model Branch {
  tradeInDevices TradeInDevice[]
  cashSessions   CashSession[]
  purchases      PurchaseOrder[]
  warrantyCases  WarrantyCase[]
  cashMovements  CashMovement[]
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  city           String?
  phone          String?
  instagram      String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  users             User[]
  products          Product[]
  orders            Order[]
  inventoryUnits    InventoryUnit[]
  stockLocations    StockLocation[]
  outgoingTransfers StockTransfer[] @relation("TransferSourceBranch")
  incomingTransfers StockTransfer[] @relation("TransferDestinationBranch")

  @@unique([tenantId, name])
  @@index([tenantId])
}

model User {
  openedCashSessions  CashSession[]   @relation("CashOpenedBy")
  closedCashSessions  CashSession[]   @relation("CashClosedBy")
  purchases           PurchaseOrder[]
  id                  String          @id @default(cuid())
  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId            String?
  branch              Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name                String
  email               String?
  pinHash             String
  role                UserRole        @default(VENDEDOR)
  status              UserStatus      @default(ACTIVE)
  // Subconjunto opcional del rol: restringe, nunca amplía permisos.
  permissions         Json?
  // Horario semanal opcional, expresado en una zona IANA. Null = sin restricción.
  accessSchedule      Json?
  failedLoginAttempts Int             @default(0)
  lockedUntil         DateTime?
  lastAccessAt        DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  orders                         Order[]
  auditLogs                      AuditLog[]
  uploadedPaymentProofs          PaymentProof[]          @relation("PaymentProofUploader")
  verifiedPaymentReconciliations PaymentReconciliation[] @relation("PaymentReconciliationVerifier")

  sessions         Session[]
  createdTransfers StockTransfer[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([branchId])
}

model Session {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  level      SessionLevel @default(COMPANY)
  deviceId   String
  branchId   String?
  tokenHash  String       @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  // Reautenticación sensible de corta duración para exportar, revocar o archivar.
  reauthenticatedAt DateTime?
  createdAt  DateTime     @default(now())
  lastSeenAt DateTime     @default(now())

  @@index([tenantId, userId])
  @@index([expiresAt])
  @@index([tenantId, reauthenticatedAt])
}

enum SessionLevel {
  COMPANY
  SELLER
}

enum UserRole {
  ADMIN
  GERENTE
  VENDEDOR
  CAJERA
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Product {
  tradeInDevice TradeInDevice?
  destination   ProductDestination @default(NORMAL)
  purchaseLines PurchaseLine[]
  id            String             @id @default(cuid())
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sku           String
  name          String
  category      String?
  imei          String?
  condition     ProductCondition   @default(NEW)
  pricePyg      Int
  costPyg       Int?
  // Si tiene valor, prevalece sobre la política de la categoría.
  insuranceRate Decimal?           @db.Decimal(5, 2)
  stock         Int                @default(0)
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  orderItems               OrderItem[]
  inventoryUnits           InventoryUnit[]
  transferSourceLines      StockTransferLine[] @relation("TransferSourceProduct")
  transferDestinationLines StockTransferLine[] @relation("TransferDestinationProduct")

  @@unique([tenantId, branchId, sku])
  @@index([tenantId, branchId])
  @@index([tenantId, imei])
}

enum InventoryUnitStatus {
  AVAILABLE
  RESERVED
  SOLD
  DEFECTIVE
  IN_TRANSIT
}

model InventoryUnit {
  id                  String              @id @default(cuid())
  tenantId            String
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId           String
  product             Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  branchId            String?
  branch              Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  locationId          String?
  location            StockLocation?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  serial              String
  // Un único modelo puede tener unidades nuevas o seminuevas con historial propio.
  // Esto evita crear un producto distinto por cada IMEI.
  condition           ProductCondition    @default(NEW)
  batteryHealth       Int?
  supplierName        String?
  purchasedAt         DateTime?
  costPyg             Int?
  costCurrency        PaymentCurrency     @default(PYG)
  originalCost        Decimal?            @db.Decimal(14, 2)
  exchangeRatePyg     Decimal?            @db.Decimal(14, 4)
  notes               String?
  reservedUntil       DateTime?
  reservationCustomer String?
  reservedById        String?
  lastVerifiedAt      DateTime?
  lastVerifiedById    String?
  verificationCount   Int                 @default(0)
  status              InventoryUnitStatus @default(AVAILABLE)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([tenantId, serial])
  @@index([tenantId, productId, status])
  @@index([tenantId, branchId, status])
  @@index([tenantId, status, reservedUntil])
  @@index([tenantId, branchId, locationId, status])
  @@index([tenantId, branchId, lastVerifiedAt])
}

// Ubicación física dentro de una sucursal: piso de venta, depósito, vitrina,
// recepción, etc. No es una sucursal nueva y no puede cruzar empresas.
model StockLocation {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name           String
  code           String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  inventoryUnits InventoryUnit[]

  @@unique([branchId, name])
  @@unique([branchId, code])
  @@index([tenantId, branchId, isActive])
}

// Permiso explícito y solo de lectura: el receptor ve disponibilidad, nunca
// costos, IMEI, clientes o movimientos de la empresa proveedora.
model InventoryVisibilityGrant {
  id                String   @id @default(cuid())
  providerTenantId  String
  providerTenant    Tenant   @relation("StockVisibilityProvider", fields: [providerTenantId], references: [id], onDelete: Cascade)
  recipientTenantId String
  recipientTenant   Tenant   @relation("StockVisibilityRecipient", fields: [recipientTenantId], references: [id], onDelete: Cascade)
  createdById       String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([providerTenantId, recipientTenantId])
  @@index([recipientTenantId, isActive])
  @@index([providerTenantId, isActive])
}

model StockTransfer {
  id                  String              @id @default(cuid())
  tenantId            String
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceBranchId      String
  sourceBranch        Branch              @relation("TransferSourceBranch", fields: [sourceBranchId], references: [id], onDelete: Restrict)
  destinationBranchId String
  destinationBranch   Branch              @relation("TransferDestinationBranch", fields: [destinationBranchId], references: [id], onDelete: Restrict)
  createdById         String
  createdBy           User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  notes               String?
  createdAt           DateTime            @default(now())
  lines               StockTransferLine[]

  @@index([tenantId, sourceBranchId, createdAt])
  @@index([tenantId, destinationBranchId, createdAt])
}

model StockTransferLine {
  id                   String        @id @default(cuid())
  transferId           String
  transfer             StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  sourceProductId      String
  sourceProduct        Product       @relation("TransferSourceProduct", fields: [sourceProductId], references: [id], onDelete: Restrict)
  destinationProductId String
  destinationProduct   Product       @relation("TransferDestinationProduct", fields: [destinationProductId], references: [id], onDelete: Restrict)
  quantity             Int
  serials              Json          @default("[]")

  @@index([transferId])
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

model Customer {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  countryCode String   @default("+595")
  email       String?
  document    String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders    Order[]
  addresses CustomerAddress[]

  @@index([tenantId])
  @@index([tenantId, phone])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String   @default("Principal")
  address    String
  city       String?
  notes      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId, isDefault])
}

model Order {
  tradeInDevices    TradeInDevice[]
  id                String            @id @default(cuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId          String?
  branch            Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerId        String?
  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sellerId          String
  seller            User              @relation(fields: [sellerId], references: [id])
  orderNumber       String
  publicToken       String            @unique @default(cuid())
  status            OrderStatus       @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(PROCESSING)
  subtotalPyg       Int
  discountPyg       Int               @default(0)
  deliveryPyg       Int               @default(0)
  deliveryType      String?
  deliveryNotes     String?
  totalPyg          Int
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([branchId])
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum FulfillmentStatus {
  PROCESSING
  IN_TRANSIT
  READY_FOR_PICKUP
  DELIVERED
}

model MessageTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  name      String
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId, isActive])
}

model OrderItem {
  promotionSnapshot    Json?
  warrantyCases        WarrantyCase[]
  id                   String         @id @default(cuid())
  orderId              String
  order                Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId            String?
  product              Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  description          String
  quantity             Int            @default(1)
  unitPricePyg         Int
  unitCostPyg          Int?
  baseUnitCostPyg      Int?
  insurancePyg         Int            @default(0)
  extraCostPyg         Int            @default(0)
  soldWithoutInsurance Boolean        @default(false)
  totalPyg             Int
  // IMEI/seriales físicos vendidos por esta línea. El producto sigue siendo
  // un modelo único; la trazabilidad queda en cada unidad seleccionada.
  serials              Json           @default("[]")

  @@index([orderId])
}

// Plantilla por categoría: por ejemplo Teléfonos = seguro 2%. Un producto
// puede sobrescribirla, y la venta siempre guarda la foto del costo aplicado.
model CostPolicy {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      String
  insuranceRate Decimal  @default(0) @db.Decimal(5, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, category])
  @@index([tenantId, isActive])
}

model Promotion {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  name      String
  kind      String
  value     Int
  productId String?
  startsAt  DateTime
  endsAt    DateTime
  maxUnits  Int?
  usedUnits Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
}

model Payment {
  accountId       String?
  account         PaymentAccount?  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  accountSnapshot Json?
  currency        PaymentCurrency?
  originalAmount  Decimal?         @db.Decimal(18, 2)
  exchangeRatePyg Decimal?         @db.Decimal(18, 6)
  tradeInDevice   TradeInDevice?
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId         String
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method          PaymentMethod
  status          PaymentStatus    @default(CONFIRMED)
  amountPyg       Int
  reference       String?
  idempotencyKey  String?
  paidAt          DateTime         @default(now())
  createdAt       DateTime         @default(now())

  proofs         PaymentProof[]
  reconciliation PaymentReconciliation?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([orderId])
}

model PaymentProof {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentId    String
  payment      Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  sizeBytes    Int
  sha256       String
  data         Bytes    @db.ByteA
  uploadedById String
  uploadedBy   User     @relation("PaymentProofUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([tenantId, paymentId, createdAt])
  @@index([uploadedById, createdAt])
}

model PaymentReconciliation {
  id           String              @id @default(cuid())
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentId    String              @unique
  payment      Payment             @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  state        ReconciliationState @default(PENDING)
  note         String?
  verifiedById String?
  verifiedBy   User?               @relation("PaymentReconciliationVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([tenantId, state])
  @@index([verifiedById, updatedAt])
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  CREDIT
  TRADE_IN
}

enum PaymentCurrency {
  PYG
  USD
  BRL
  EUR
  USDT
}

enum PaymentAccountKind {
  CASH
  TRANSFER
  CARD
  TRADE_IN
}

enum ProductDestination {
  NORMAL
  OFFER
  WHOLESALE
}

enum TradeInStatus {
  RECEIVED
  REVIEW
  REPAIR
  READY
  STOCK
  SOLD_EXTERNAL
}

model PaymentAccount {
  id            String             @id @default(cuid())
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  bank          String?
  holder        String?
  accountNumber String?
  currency      PaymentCurrency
  kind          PaymentAccountKind
  isActive      Boolean            @default(true)
  feePercent    Decimal            @default(0) @db.Decimal(5, 2)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  payments      Payment[]
  cashMovements CashMovement[]
  purchasePayments PurchasePayment[]

  @@index([tenantId, isActive])
}

model TradeInDevice {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId      String        @unique
  payment        Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  serial         String
  model          String
  conditionNotes String
  valuePyg       Int
  status         TradeInStatus @default(RECEIVED)
  repairCostPyg  Int           @default(0)
  diagnosis      String?
  technicianName String?
  accessories    Json          @default("[]")
  photos         Json          @default("[]")
  notes          String?
  productId      String?       @unique
  product        Product?      @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([tenantId, serial])
  @@index([tenantId, branchId, status])
  @@index([orderId])
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
  REFUNDED
}

enum ReconciliationState {
  PENDING
  VERIFIED
  REJECTED
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
}

model CashSession {
  id          String    @id
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  openedById  String
  openedBy    User      @relation("CashOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedById  String?
  closedBy    User?     @relation("CashClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  openingPyg  Int
  countedPyg  Int?
  expectedPyg Int?
  status      String    @default("OPEN")
  notes       String?

  // Una caja abierta por sucursal: índice parcial definido en la migración SQL.
  @@index([tenantId, branchId, openedAt])
}

// Libro de movimientos no ligados a una venta: gastos, cheques, adelantos y
// transferencias. Cada registro conserva la moneda/cotización de su fecha.
model CashMovement {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  accountId       String?
  account         PaymentAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdById     String
  kind            CashMovementKind
  direction       CashDirection
  currency        PaymentCurrency @default(PYG)
  originalAmount  Decimal         @db.Decimal(18, 2)
  exchangeRatePyg Decimal         @default(1) @db.Decimal(18, 6)
  amountPyg       Int
  counterparty    String?
  reference       String?
  description     String
  status          CashMovementStatus @default(PENDING)
  dueAt           DateTime?
  clearedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, status, dueAt])
  @@index([accountId, createdAt])
}

enum CashMovementKind {
  EXPENSE
  TRANSFER
  SUPPLIER_ADVANCE
  CHEQUE
  OWNER_WITHDRAWAL
  ADJUSTMENT
}

enum CashDirection {
  IN
  OUT
}

enum CashMovementStatus {
  PENDING
  CLEARED
  VOID
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
}

model PurchaseOrder {
  id           String         @id
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplierName String
  status       PurchaseStatus @default(DRAFT)
  createdAt    DateTime       @default(now())
  receivedAt   DateTime?
  createdById  String
  createdBy    User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  shippingPyg  Int            @default(0)
  customsPyg   Int            @default(0)
  insurancePyg Int            @default(0)
  taxesPyg     Int            @default(0)
  otherCostsPyg Int           @default(0)
  currency     PaymentCurrency @default(PYG)
  exchangeRatePyg Decimal     @default(1) @db.Decimal(18, 6)
  originalSubtotal Decimal?   @db.Decimal(18, 2)
  dueAt        DateTime?
  supplierReference String?
  lines        PurchaseLine[]
  payments     PurchasePayment[]

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

model PurchaseLine {
  id          String        @id
  purchaseId  String
  purchase    PurchaseOrder @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Int
  unitCostPyg Int

  @@index([purchaseId])
  @@index([productId])
}

model PurchasePayment {
  id              String          @id @default(cuid())
  tenantId        String
  purchaseId      String
  purchase        PurchaseOrder   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  accountId       String?
  account         PaymentAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  amountPyg       Int
  currency        PaymentCurrency @default(PYG)
  originalAmount  Decimal         @db.Decimal(18, 2)
  exchangeRatePyg Decimal         @default(1) @db.Decimal(18, 6)
  reference       String?
  paidAt          DateTime        @default(now())
  createdById     String
  createdAt       DateTime        @default(now())

  @@index([tenantId, purchaseId, paidAt])
}

enum WarrantyStatus {
  RECEIVED
  DIAGNOSIS
  READY
  DELIVERED
}

model WarrantyCase {
  id              String         @id
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  orderItemId     String?
  orderItem       OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  customerName    String
  serial          String
  description     String
  status          WarrantyStatus @default(RECEIVED)
  responsibleName String?
  diagnosis       String?
  technicianName  String?
  parts           Json           @default("[]")
  photos          Json           @default("[]")
  resolution      String?
  repairCostPyg   Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
  expiresAt       DateTime?

  @@index([tenantId, createdAt])
  @@index([tenantId, serial])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
}
