{
  "name": "mobos-backend",
  "version": "1.0.243",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "prisma generate --schema prisma/schema.prisma && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "test:reports": "node tests/run-reporting.cjs",
    "test:mcp:sdk-http": "node tests/mcp-sdk-http.mjs",
    "test:unit": "node tests/run-unit.cjs",
    "modulos:backfill": "node scripts/run-ts.cjs scripts/modulos-v2-backfill.ts",
    "stock:check": "node tests/stock-consistency.mjs",
    "consistency:check": "node tests/consistency-check.mjs",
    "consistency:selftest": "node tests/consistency-selftest.mjs",
    "audit:prune": "node tests/prune-audit.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.6.0",
    "bcryptjs": "^3.0.3",
    "next": "15.5.28",
    "pg": "^8.23.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "prisma": "^7.6.0",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.30"
    },
    "source-map-js": "1.2.2",
    "fast-uri": "3.1.8",
    "mysql2": "3.24.6",
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
