# API productiva de MobOS en OwnCoding Hub.
# Se versiona para que cualquier build de produccion (local o desde Hub)
# quede conectado al backend real. Las variables del entorno del servidor
# siguen teniendo prioridad sobre este archivo.
VITE_API_URL=https://api.moboss.online
# Base de los QR impresos y enlaces públicos: el papel no depende del host que
# sirva el build (src/lib/printing/qr.js).
VITE_APP_URL=https://app.moboss.online
