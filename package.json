{
  "name": "mobos",
  "private": true,
  "version": "1.0.237",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src scripts print-agent",
    "lint:fix": "eslint src scripts --fix",
    "db:check": "node scripts/check-db-schema.mjs",
    "test": "node --test \"src/**/*.test.js\" \"print-agent/**/*.test.mjs\" scripts/release.test.mjs",
    "audit:logs": "node scripts/audit-logs.mjs",
    "rotacion:tokens": "node scripts/checklist-rotacion-tokens.mjs",
    "emails:prueba": "node scripts/emails-prueba.mjs",
    "ci:guardia": "node scripts/qa-ci-guardia.mjs",
    "pack:agent": "node scripts/pack-agent.mjs",
    "pack:agent:check": "node scripts/pack-agent.mjs --check",
    "aex:sandbox": "node scripts/aex-sandbox-prueba.mjs",
    "qa:imei:prod": "node scripts/qa-193-imei-produccion.mjs",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"scripts/**/*.mjs\"",
    "release:prepare": "node scripts/release.mjs",
    "release:smoke": "node scripts/smoke.mjs",
    "release:publish": "node scripts/release.mjs --publish --deploy --deploy-current",
    "test:e2e": "playwright test",
    "test:print-agent": "npm --prefix print-agent test",
    "test:e2e:smoke": "playwright test --grep 'seller logs in with company credentials|registers the sale and lists it in pedidos|clic en la fila abre el pedido por su id interno|owner-only nav items|resumen shows the dashboard KPIs|lists the seeded serialized unit|returns the minimal public payload|has no horizontal overflow'",
    "release:prepare-version": "node scripts/release.mjs --prepare-version",
    "release:build-current": "node scripts/release.mjs --build-current",
    "test:release": "node --test scripts/release.test.mjs",
    "build:ios": "VITE_PLATFORM=ios VITE_API_URL=https://api.moboss.online vite build && cap sync ios",
    "build:ios:dev": "VITE_PLATFORM=ios VITE_PUSH_ENV=sandbox VITE_API_URL=https://api.moboss.online vite build && cap sync ios",
    "ios:open": "cap open ios",
    "prebuild": "node scripts/preparar-novedades.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^9.1.2",
    "@aparajita/capacitor-secure-storage": "^7.1.6",
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor-mlkit/barcode-scanning": "^7.5.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/network": "^7.0.4",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@capgo/capacitor-social-login": "^7.20.0",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.11",
    "jsbarcode": "^3.11.6",
    "lucide-react": "^0.456.0",
    "owncoding-ui": "https://github.com/dariodeoli/owncoding-ui/archive/refs/tags/v0.68.13.tar.gz",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "read-excel-file": "^9.3.10",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11",
    "write-excel-file": "^4.1.1"
  }
}
