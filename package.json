{
  "name": "mobos",
  "private": true,
  "version": "1.0.132",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src scripts print-agent",
    "lint:fix": "eslint src scripts --fix",
    "db:check": "node scripts/check-db-schema.mjs",
    "test": "node --test \"src/**/*.test.js\" \"print-agent/**/*.test.mjs\"",
    "pack:agent": "node scripts/pack-agent.mjs",
    "pack:agent:check": "node scripts/pack-agent.mjs --check",
    "aex:sandbox": "node scripts/aex-sandbox-prueba.mjs",
    "qa:imei:prod": "node scripts/qa-193-imei-produccion.mjs",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"scripts/**/*.mjs\"",
    "release:prepare": "node scripts/release.mjs",
    "release:smoke": "node scripts/smoke.mjs",
    "release:publish": "node scripts/release.mjs --publish --deploy",
    "test:e2e": "playwright test",
    "test:print-agent": "npm --prefix print-agent test",
    "test:e2e:smoke": "playwright test --grep 'seller logs in with company credentials|registers the sale and lists it in pedidos|clic en la fila abre el pedido por su id interno|owner-only nav items|resumen shows the dashboard KPIs|lists the seeded serialized unit|returns the minimal public payload'"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.11",
    "jsbarcode": "^3.11.6",
    "lucide-react": "^0.456.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "read-excel-file": "^9.3.10",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11",
    "write-excel-file": "^4.1.1"
  }
}
